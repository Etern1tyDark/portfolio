---
import { withBasePath } from '../utils/withBasePath';
---

<section class="about-contact" data-stagger-group>
  <div class="contact-header reveal-up">
    <p class="eyebrow">Contact</p>
    <h2 class="text-4xl font-bold text-blue-400">Let's Connect</h2>
    <p class="section-sub">If you want to collaborate on CTFs, security work, or research, reach me here.</p>
  </div>

  <div class="contact-grid">
    <article class="card p-6 contact-card" data-stagger-item>
      <h3 class="text-xl font-bold text-cyan-300">Direct</h3>
      <ul class="contact-list">
        <li><span>Email:</span> <a href="mailto:nathankhopancras@gmail.com">nathankhopancras@gmail.com</a></li>
        <li>
          <span>Discord:</span>
          <a href="https://discord.com/users/461725672658698267" target="_blank" rel="noopener noreferrer">etern1tydark</a>
          <button type="button" class="copy-handle" data-copy="etern1tydark" title="Copy username" aria-label="Copy Discord username">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
          <small class="copy-status" aria-live="polite"></small>
        </li>
      </ul>
    </article>

    <article class="card p-6 contact-card" data-stagger-item>
      <h3 class="text-xl font-bold text-cyan-300">Profiles</h3>
      <ul class="contact-list">
        <li><span>LinkedIn:</span> <a href="https://linkedin.com/in/nathan-k-pancras" target="_blank" rel="noopener noreferrer">nathan-k-pancras</a></li>
        <li><span>GitHub:</span> <a href="https://github.com/Etern1tyDark" target="_blank" rel="noopener noreferrer">Etern1tyDark</a> / <a href="https://github.com/NathanKhoP" target="_blank" rel="noopener noreferrer">NathanKhoP</a></li>
      </ul>
    </article>
  </div>

  <div class="cv-cta-wrap">
    <a class="btn btn-primary cv-btn-long" href={withBasePath('/CV.pdf')} download="Nathan-Kho-Pancras-CV.pdf">Download CV</a>
  </div>
</section>

<style>
  .about-contact {
    margin-top: 4rem;
    text-align: left;
  }

  .contact-header {
    margin-bottom: 1.75rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: rgba(192, 202, 245, 0.85);
    line-height: 1.5;
  }

  .contact-list span {
    color: rgba(192, 202, 245, 0.65);
    margin-right: 0.35rem;
  }

  .copy-handle {
    display: inline-flex;
    vertical-align: middle;
    margin-left: 0.3rem;
    padding: 0.2rem;
    border-radius: 0.35rem;
    color: rgba(192, 202, 245, 0.65);
    cursor: copy;
  }

  .copy-handle:hover {
    color: #7aa2f7;
    background: rgba(122, 162, 247, 0.12);
  }

  .copy-status {
    margin-left: 0.4rem;
    font-size: 0.75rem;
    color: #9ece6a;
  }

  :global(html.light) .copy-handle {
    color: #646a88;
  }

  :global(html.light) .copy-status {
    color: #1d7a4f;
  }

  :global(html.light) .contact-list {
    color: #3b4261;
  }

  :global(html.light) .contact-list span {
    color: #646a88;
  }

  .cv-cta-wrap {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .cv-btn-long {
    width: min(100%, 680px);
    justify-content: center;
    padding: 0.95rem 1.4rem;
    border-radius: 0.85rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .eyebrow {
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: rgba(192, 202, 245, 0.7);
    margin-bottom: 0.5rem;
  }

  .section-sub {
    color: rgba(192, 202, 245, 0.7);
    margin-top: 0.25rem;
  }
</style>

<script>
  // Copy the Discord handle for "Add Friend" (the profile link needs a Discord login).
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy]");
    if (!button) return;
    const status = button.parentElement?.querySelector(".copy-status");
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      if (status) status.textContent = "Copied!";
    } catch {
      if (status) status.textContent = "Copy failed";
    }
    window.setTimeout(() => status && (status.textContent = ""), 1800);
  });
</script>
