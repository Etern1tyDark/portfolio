---
interface ExperienceItem {
  period: string;
  title: string;
  company: string;
  description: string;
  tags: string[];
}
interface Props {
  experiences: ExperienceItem[];
}
const { experiences } = Astro.props;
---

<section class="timeline" data-stagger-group>
  <div class="line line-left" aria-hidden="true"></div>
  <div class="line line-right" aria-hidden="true"></div>

  {experiences.map((exp, index) => {
    const side = index % 2 === 0 ? 'left' : 'right';
    return (
      <article class={`item ${side}`} data-stagger-item>
        <span class="dot" aria-hidden="true"></span>

        <div class="card">
          <time class="font-mono italic text-sm text-gray-400">{exp.period}</time>
          <div class="text-lg font-bold text-blue-400 mt-2">{exp.title}</div>
          <div class="text-base font-semibold text-purple-400">{exp.company}</div>
          <p class="text-gray-300 py-2">{exp.description}</p>
          <div class="flex flex-wrap gap-2 mt-3">
            {exp.tags.map((tag) => (
              <span class="border border-gray-500 text-gray-300 px-2 py-1 rounded text-xs">{tag}</span>
            ))}
          </div>
        </div>
      </article>
    );
  })}
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 3vw, 2.75rem);
    padding: 0 0 1rem;
    --line-left: 16%;
    --line-right: 84%;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, rgba(122, 162, 247, 0.5), rgba(86, 95, 137, 0.6));
    pointer-events: none;
  }

  .line-left { left: var(--line-left); }
  .line-right { left: var(--line-right); }

  .item {
    position: relative;
    max-width: 760px;
    width: 100%;
  }

  .item.left {
    align-self: flex-start;
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    padding-right: clamp(4rem, 8vw, 6rem);
    text-align: left;
  }

  .item.right {
    align-self: flex-end;
    padding-right: clamp(1.5rem, 3vw, 2.5rem);
    padding-left: clamp(4rem, 8vw, 6rem);
    text-align: right;
  }

  .card {
    background: var(--tokyo-surface-2, #1f2335);
    border: 1px solid rgba(86, 95, 137, 0.45);
    border-radius: 12px;
    padding: 1rem 1.2rem;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
    position: relative;
    z-index: 1;
  }

  /* Marks each entry on the line; only on phones, where the line runs beside
     the cards instead of behind them. */
  .dot {
    display: none;
    position: absolute;
    top: 1.35rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 9999px;
    background: var(--tokyo-surface-2, #1f2335);
    border: 2px solid var(--tokyo-blue, #7aa2f7);
    box-shadow: 0 0 10px rgba(122, 162, 247, 0.45);
    z-index: 2;
  }

  @media (max-width: 767px) {
    .timeline {
      --line-left: 0.5rem;
      --line-right: 0.5rem;
      padding-left: 0.75rem;
    }
    .item.left,
    .item.right {
      align-self: stretch;
      padding-left: 1.75rem;
      padding-right: 0.5rem;
      text-align: left;
    }
    .dot {
      display: block;
      /* The line sits 0.5rem into the timeline, items start 0.75rem in. */
      left: calc(-0.25rem + 1px);
      transform: translateX(-50%);
    }
  }
</style>
