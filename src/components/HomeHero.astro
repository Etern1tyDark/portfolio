---
import { withBasePath } from '../utils/withBasePath';
import music from '../data/music.json';
import { parseSimai } from '../utils/simai';

const titleVariants = [
  "Hello!",
  "Welcome!",
  "Hi there!",
  "Greetings!",
  "Hey!"
];

const lanePhrases = titleVariants;
const rhythmInputKey = "F";
// Second key once hard mode is unlocked, for alternating on streams.
const altInputKey = "J";

// Hard-mode charts: 1K simai in src/data/charts/<name>.txt (format in
// scripts/simai-to-1k.py). Notes closer than this can't be told apart on one lane.
const CHART_MIN_GAP_MS = 30;
const chartFiles = import.meta.glob<string>('../data/charts/*.txt', { eager: true, query: '?raw', import: 'default' });
const rhythmTracks = Object.fromEntries(
  Object.entries(music.tracks).map(([id, t]) => {
    const text = chartFiles[`../data/charts/${t.chart}.txt`];
    const chart = text ? parseSimai(text, CHART_MIN_GAP_MS) : null;
    return [
      id,
      {
        title: t.title,
        offsetMs: t.offsetMs,
        timingPoints: t.timingPoints,
        // The round ends at the chart's E (or the end of the audio, if sooner).
        chart: chart
          ? {
              notes: chart.notes,
              big: chart.big.map((b) => (b ? 1 : 0)),
              endMs: Math.min(chart.endMs, t.durationMs - 100),
              durationMs: t.durationMs,
            }
          : null,
      },
    ];
  }),
);
const { normalTrack, hardTracks } = music;
const hardSongs = hardTracks.map((id) => ({ id, title: music.tracks[id as keyof typeof music.tracks].title }));
---

<section class="hero min-h-screen hero-tones relative overflow-hidden">
  <div class="hero-aurora" aria-hidden="true"></div>
  <div class="hero-rings" aria-hidden="true"></div>
  <div class="hero-content text-center">
    <div class="max-w-5xl mx-auto space-y-6 px-4">
      <!-- <p class="eyebrow hero-kicker text-sm">{hero.kicker}</p> -->
      <h1 class="hero-title mb-4" aria-label="Welcome, Hello, Hi there, Greetings, Hey">
        <div id="rhythm-lane" class="rhythm-lane" aria-hidden="true">
          <div id="judgement-line" class="judgement-line">
            <span class="judgement-marker judgement-marker-top" aria-hidden="true"></span>
            <span class="judgement-marker judgement-marker-bottom" aria-hidden="true"></span>
            <span class="judgement-tag">JUDGEMENT</span>
          </div>
          <div class="rhythm-stream"></div>
        </div>
      </h1>
      <div class="hero-rhythm-controls-wrapper">
        <p class="hero-rhythm-hint hidden md:block">
          Press <kbd>{rhythmInputKey}</kbd><span data-alt-key hidden> or <kbd>{altInputKey}</kbd></span> to the notes!
        </p>
        <button id="mobile-rhythm-btn" class="hero-rhythm-tap-btn md:hidden">
          TAP TO THE NOTES!
        </button>
        <div class="rhythm-mode-row">
          <div class="rhythm-mode" data-rhythm-mode data-unlocked-only role="group" aria-label="Rhythm game difficulty" hidden>
            <button type="button" data-mode="normal" aria-pressed="true">NORMAL</button>
            <button type="button" data-mode="hard" aria-pressed="false">HARD</button>
          </div>
          <button type="button" class="rhythm-restart" data-rhythm-restart data-unlocked-only title="Restart the song" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
            RESTART
          </button>
          <button type="button" class="rhythm-restart" data-rhythm-options-open title="Scroll speed and offset">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
            OPTIONS
          </button>
        </div>
        <div class="rhythm-songs" data-rhythm-songs role="group" aria-label="Hard mode song" hidden>
          {hardSongs.map((song) => (
            <button type="button" data-song={song.id} aria-pressed="false">{song.title}</button>
          ))}
        </div>
      </div>
      <p id="rhythm-judgement" class="hero-rhythm-judge" aria-live="polite"></p>
      <p class="text-base md:text-lg text-gray-200 hero-subtitle max-w-xl mx-auto leading-relaxed">
        I'm Nathan, a final-year Information Technology student focused on cybersecurity, with active work in cryptography, forensics, red teaming, and software development.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center mt-8 hero-cta px-4 sm:px-0">
        <a href={withBasePath('/blog')} class="btn btn-primary px-8 py-3 text-lg sm:text-xl rounded-xl w-full sm:w-auto">View Blogs</a>
        <a href={withBasePath('/experience')} class="btn btn-outline px-8 py-3 text-lg sm:text-xl rounded-xl transition-all w-full sm:w-auto">Experience</a>
      </div>

      <!-- <div class="hero-meta" data-stagger-group>
        {hero.chips.map((chip) => (
          <span class="meta-chip" data-stagger-item>{chip}</span>
        ))}
      </div> -->
    </div>
  </div>

  <dialog id="rhythm-results" class="rhythm-results" aria-labelledby="rhythm-results-title">
    <div class="rr-card">
      <p class="rr-eyebrow" data-rr="eyebrow">RESULT</p>
      <div class="rr-rank-row">
        <span class="rr-rank" data-rr="rank">S</span>
        <span class="rr-badge" data-rr="badge" hidden></span>
      </div>
      <h2 id="rhythm-results-title" class="rr-score" data-rr="score">0</h2>
      <p class="rr-accuracy"><span data-rr="accuracy">0.00</span>%</p>
      <dl class="rr-stats">
        <div class="rr-stat critical"><dt>CRITICAL</dt><dd data-rr="critical">0</dd></div>
        <div class="rr-stat perfect"><dt>PERFECT</dt><dd data-rr="perfect">0</dd></div>
        <div class="rr-stat great"><dt>GREAT</dt><dd data-rr="great">0</dd></div>
        <div class="rr-stat good"><dt>GOOD</dt><dd data-rr="good">0</dd></div>
        <div class="rr-stat miss"><dt>MISS</dt><dd data-rr="miss">0</dd></div>
        <div class="rr-stat"><dt>MAX COMBO</dt><dd data-rr="combo">0</dd></div>
      </dl>
      <p class="rr-offset">Avg. timing <span data-rr="offset">±0ms</span></p>
      <div class="rr-calibrate" data-rr-calibrate hidden>
        <span class="rr-calibrate-label" title="Shifts notes against the music on this device. Raise it if notes feel early compared to what you hear.">Offset</span>
        <button type="button" class="rr-step" data-rr-offset="-5" aria-label="Notes 5ms earlier">−</button>
        <output class="rr-calibrate-value" data-rr="user-offset">+0ms</output>
        <button type="button" class="rr-step" data-rr-offset="5" aria-label="Notes 5ms later">+</button>
        <button type="button" class="rr-auto" data-rr-offset="auto" data-rr="auto">Match avg</button>
      </div>
      <div class="rr-unlock" data-rr-unlock hidden>
        <p class="rr-unlock-title">HARD MODE UNLOCKED</p>
        <p class="rr-unlock-text">
          Real charts for {hardSongs.map((song, i) => <>{i > 0 && (i === hardSongs.length - 1 ? ' and ' : ', ')}<strong>{song.title}</strong></>)},
          and <kbd>{rhythmInputKey}</kbd> + <kbd>{altInputKey}</kbd> to alternate. Switch anytime below the lane.
        </p>
        <button type="button" class="rr-unlock-btn" data-rr-mode="hard">Play hard mode</button>
      </div>
      <button type="button" class="rr-retry btn btn-primary" data-rr-close autofocus>Play again</button>
    </div>
  </dialog>

  <dialog id="rhythm-options" class="rhythm-results" aria-labelledby="rhythm-options-title">
    <div class="rr-card ro-card">
      <h2 id="rhythm-options-title" class="rr-eyebrow">OPTIONS</h2>
      <label class="ro-field">
        <span class="ro-label">Scroll speed <output data-ro="speed-value">1.0×</output></span>
        <input type="range" min="0.5" max="3" step="0.1" value="1" data-ro="speed" />
      </label>
      <p class="ro-help">Faster spreads dense streams out so notes don't overlap.</p>
      <div class="ro-field">
        <span class="ro-label">Audio offset</span>
        <div class="ro-stepper">
          <button type="button" class="rr-step" data-ro-offset="-5" aria-label="Notes 5ms earlier">−</button>
          <output class="rr-calibrate-value" data-ro="offset-value">±0ms</output>
          <button type="button" class="rr-step" data-ro-offset="5" aria-label="Notes 5ms later">+</button>
        </div>
      </div>
      <p class="ro-help">Raise it if notes reach the line before you hear the beat. Both are saved on this device.</p>
      <div class="ro-actions">
        <button type="button" class="rr-auto" data-ro-reset>Reset</button>
        <button type="button" class="btn btn-primary ro-done" data-ro-close>Done</button>
      </div>
    </div>
  </dialog>
</section>

<script define:vars={{ rhythmInputKey, altInputKey, lanePhrases, rhythmTracks, normalTrack, hardTracks }} is:inline>
  (() => {
    // Hit windows (ms either side of the beat), tightest first.
    const JUDGEMENTS = [
      { name: "CRITICAL", ms: 16.67, weight: 1 },
      { name: "PERFECT", ms: 50, weight: 0.95 },
      { name: "GREAT", ms: 90, weight: 0.8 },
      { name: "GOOD", ms: 140, weight: 0.5 },
    ];
    const MISS_MS = JUDGEMENTS[JUDGEMENTS.length - 1].ms;

    // Per difficulty: how long a note takes to cross the whole lane, and how
    // many notes make a round (the results screen shows after that many).
    const MODES = {
      normal: { laneCrossMs: 5600, laneCrossMsMobile: 4600, roundNotes: 10 },
      hard: { laneCrossMs: 3400, laneCrossMsMobile: 2400, roundNotes: 32 },
    };
    const NOTE_GAP_PX = 120;
    const MIN_NOTE_INTERVAL_MS = 1850;
    // The first note starts part-way across so the lane isn't empty on load.
    const FIRST_NOTE_LEAD_MS = 1600;
    const NOTE_FADE_IN_MS = 280;
    // Big notes: the second key must follow the first within this.
    const BIG_PAIR_MS = 60;
    // Normal notes land on bar lines (every `meter` beats, or 2 if unset).
    const BEAT_STEP = 2;
    // Hard mode is a 1K chart on a half-beat grid: one rhythm pattern per bar
    // ("x" = note), picked deterministically so a song always plays the same.
    const HARD_PATTERNS = {
      3: ["x.x.x.", "x.x.xx", "x.xxx.", "xx.x.x", "x.x.x.", "xxx.x.", "x..xx.", "x.x..."],
      4: ["x.x.x.x.", "x.x.xxx.", "xx.x.x.x", "x.xx.x..", "x.x.x.x.", "xxx.x.x.", "x..xx.x.", "x.x.x..."],
    };
    // audio.currentTime is coarse and jittery (badly so in Firefox: it can sit
    // still for a frame, then jump ~250ms), so the song clock runs on
    // performance.now() and is only nudged toward it by a fraction of the error
    // per new reading. Bigger gaps (seek, stall, loop) re-anchor it outright.
    const CLOCK_SLEW = 0.04;
    const CLOCK_SNAP_MS = 300;

    // Results screen: a round starts on the first hit and ends after
    // MODES[mode].roundNotes notes.
    // Give up on a round quietly if the player walked away mid-way.
    const ABANDON_MISS_STREAK = 4;
    const ABANDON_IDLE_MS = 6000;

    // Per-device offset on top of the track's (audio output delay differs a lot
    // between devices, e.g. phones and Bluetooth headphones).
    const USER_OFFSET_KEY = "rhythm-offset";
    const USER_OFFSET_LIMIT_MS = 300;
    // Scroll speed multiplier from the options menu.
    const SPEED_KEY = "rhythm-speed";
    const SPEED_MIN = 0.5;
    const SPEED_MAX = 3;

    const readSpeed = () => {
      let value = 1;
      try {
        value = Number(localStorage.getItem(SPEED_KEY)) || 1;
      } catch {}
      return Math.max(SPEED_MIN, Math.min(SPEED_MAX, value));
    };

    const writeSpeed = (value) => {
      try {
        localStorage.setItem(SPEED_KEY, String(value));
      } catch {}
    };

    const readUserOffset = () => {
      try {
        return Number(localStorage.getItem(USER_OFFSET_KEY)) || 0;
      } catch {
        return 0;
      }
    };

    const writeUserOffset = (value) => {
      const clamped = Math.max(-USER_OFFSET_LIMIT_MS, Math.min(USER_OFFSET_LIMIT_MS, Math.round(value)));
      try {
        localStorage.setItem(USER_OFFSET_KEY, String(clamped));
      } catch {}
      return clamped;
    };

    const formatMs = (ms) => (ms === 0 ? "±0ms" : `${ms > 0 ? "+" : ""}${ms}ms`);

    // Hard mode unlocks on an ALL PERFECT round; both are remembered per device.
    // The music player reads the same keys to pick its track.
    const UNLOCK_KEY = "rhythm-unlocked";
    const MODE_KEY = "rhythm-mode";

    const readStore = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const writeStore = (key, value) => {
      try {
        localStorage.setItem(key, value);
      } catch {}
    };

    const SONG_KEY = "rhythm-song";

    const isUnlocked = () => readStore(UNLOCK_KEY) === "1";
    const currentMode = () => (isUnlocked() && readStore(MODE_KEY) === "hard" ? "hard" : "normal");
    // The hard-mode song, defaulting to the first one that isn't the normal song.
    const currentSong = () => {
      const stored = readStore(SONG_KEY);
      return hardTracks.includes(stored) ? stored : (hardTracks.find((id) => id !== normalTrack) ?? hardTracks[0]);
    };
    const trackFor = (mode) => (mode === "hard" && hardTracks.length ? currentSong() : normalTrack);
    const setMode = (mode) => {
      writeStore(MODE_KEY, mode);
      window.dispatchEvent(new CustomEvent("rhythm-mode", { detail: mode }));
    };

    // Keep the active lane's cleanup on window so a lane is never mounted twice.
    const CLEANUP_KEY = "__rhythmLaneCleanup";

    const isEditableTarget = (target) =>
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.tagName === "SELECT");

    const buildNoteElement = (text) => {
      const note = document.createElement("span");
      note.className = "rhythm-note";

      const word = document.createElement("span");
      word.className = "rhythm-word";

      const wordRow = document.createElement("span");
      wordRow.className = "rhythm-word-row";
      word.appendChild(wordRow);
      note.appendChild(word);

      for (const char of Array.from(text)) {
        const charNode = document.createElement("span");
        charNode.className = "rhythm-char" + (char === " " ? " is-space" : "");

        const glyph = document.createElement("span");
        glyph.className = "char-glyph";
        glyph.textContent = char;
        charNode.appendChild(glyph);

        wordRow.appendChild(charNode);
      }

      const tap = document.createElement("span");
      tap.className = /[a-z]/i.test(text) ? "tap-note" : "tap-note tap-note-ghost";
      word.appendChild(tap);

      return note;
    };

    const buildTapNote = (big) => {
      const note = document.createElement("span");
      note.className = "rhythm-note is-tap";
      const dot = document.createElement("span");
      dot.className = big ? "hard-note is-big" : "hard-note";
      note.appendChild(dot);
      return note;
    };

    const timings = Object.fromEntries(
      Object.entries(rhythmTracks).map(([id, t]) => [
        id,
        {
          title: t.title,
          offsetMs: t.offsetMs,
          points: [...t.timingPoints].sort((a, b) => a.timeMs - b.timeMs),
          chart: t.chart,
        },
      ]),
    );
    const timingFor = (trackId) => timings[trackId] ?? timings[normalTrack];

    // First note of a song's chart at or after `t` (song ms), before `end`.
    const chartNoteAtOrAfter = (notes, t, end) => {
      let lo = 0;
      let hi = notes.length;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (notes[mid] < t - 0.5) lo = mid + 1;
        else hi = mid;
      }
      return lo < notes.length && notes[lo] < end ? notes[lo] : Infinity;
    };

    // Is the chart note at song-local time `local` a big one?
    const chartBigAt = (chart, local) => {
      const i = Math.min(chart.notes.length - 1, Math.max(0, chartNoteIndexNear(chart.notes, local)));
      return Math.abs(chart.notes[i] - local) < 1 && chart.big[i] === 1;
    };
    const chartNoteIndexNear = (notes, t) => {
      let lo = 0;
      let hi = notes.length;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (notes[mid] < t - 0.5) lo = mid + 1;
        else hi = mid;
      }
      return lo;
    };

    // Map a chart time that keeps growing across song loops into one loop of
    // `length` ms (shifted by the song offset), find a note there, and map back.
    const loopedNoteAtOrAfter = (t, length, shift, find) => {
      if (!Number.isFinite(length)) return find(t + shift, Infinity) - shift;
      const shifted = t + shift;
      const loop = Math.floor(shifted / length);
      let note = find(shifted - loop * length, length);
      let base = loop * length;
      if (note === Infinity) {
        base += length;
        note = find(0, length);
      }
      return base + note - shift;
    };

    // Grids for songs without a chart file: which slots of a tempo section hold
    // notes, per difficulty.
    const CHARTS = {
      normal: { stepBeats: (meter) => meter, has: () => true },
      hard: {
        stepBeats: () => 0.5,
        has(k, meter, section) {
          const slots = meter * 2;
          const patterns = HARD_PATTERNS[meter];
          if (!patterns) return k % 2 === 0;
          const bar = Math.floor(k / slots) + section * 31;
          return patterns[(bar * 5 + Math.floor(bar / 4)) % patterns.length][k % slots] === "x";
        },
      },
    };

    // First chart note at or after `t` (ms into the song), walking each tempo
    // section's grid. Returns Infinity past the last note before `end`.
    const noteAtOrAfter = (t, points, end, chart) => {
      for (let i = 0; i < points.length; i += 1) {
        const sectionStart = points[i].timeMs;
        const sectionEnd = Math.min(points[i + 1]?.timeMs ?? Infinity, end);
        if (t >= sectionEnd) continue;
        const meter = points[i].meter ?? BEAT_STEP;
        const step = (60000 / points[i].bpm) * chart.stepBeats(meter);
        for (let k = Math.max(0, Math.ceil((t - sectionStart - 0.5) / step)); ; k += 1) {
          const time = sectionStart + k * step;
          if (time >= sectionEnd) break;
          if (chart.has(k, meter, i)) return time;
        }
      }
      return Infinity;
    };

    // Song clock. While the track plays, chart time follows audio.currentTime
    // (smoothed, see CLOCK_SLEW) and counts loops; otherwise it free-runs (the
    // hard chart from its start, or the first section's tempo grid).
    const createClock = (audio, mode) => {
      const grid = CHARTS[mode];
      const playing = !!audio && !audio.paused && audio.readyState >= 2 && audio.duration > 0;
      const timing = timingFor(playing ? audio.dataset.track : trackFor(mode));
      const chartNotes = mode === "hard" ? timing.chart?.notes : null;

      if (!playing) {
        const first = timing.points[0];
        const origin = performance.now();
        return {
          synced: false,
          track: trackFor(mode),
          wholeSong: !!chartNotes,
          // Chart time of the E marker in the pass through the song containing t.
          endOf: (t) => {
            const length = timing.chart.durationMs;
            return Math.floor(t / length) * length + timing.chart.endMs;
          },
          loopLength: chartNotes ? timing.chart.durationMs : Infinity,
          at: (perfNow) => perfNow - origin,
          sync: () => {},
          isBig: (t) => !!chartNotes && chartBigAt(timing.chart, ((t % timing.chart.durationMs) + timing.chart.durationMs) % timing.chart.durationMs),
          noteAtOrAfter: chartNotes
            ? (t) => loopedNoteAtOrAfter(t, timing.chart.durationMs, 0, (local, end) => chartNoteAtOrAfter(chartNotes, local, end))
            : (t) => noteAtOrAfter(t, [{ ...first, timeMs: 0 }], Infinity, grid),
        };
      }

      // Positive offsets make notes arrive later relative to the music.
      const offsetMs = timing.offsetMs + readUserOffset();
      const duration = audio.duration * 1000;
      let loops = 0;
      let lastRaw = audio.currentTime * 1000;
      let basePerf = performance.now();
      let baseChart = lastRaw - offsetMs;

      return {
        synced: true,
        track: audio.dataset.track,
        // Hard charts run for the whole song: the round ends at the chart's E.
        wholeSong: !!chartNotes,
        endOf: (t) => Math.floor((t + offsetMs) / duration) * duration + timing.chart.endMs - offsetMs,
        isBig: (t) => !!chartNotes && chartBigAt(timing.chart, (((t + offsetMs) % duration) + duration) % duration),
        loopLength: duration,
        at: (perfNow) => baseChart + (perfNow - basePerf) * audio.playbackRate,
        sync(perfNow) {
          const raw = audio.currentTime * 1000;
          // A repeated value is a stale reading, not the song standing still.
          if (raw === lastRaw) return;
          if (raw < lastRaw - duration / 2) loops += 1;
          lastRaw = raw;
          const error = loops * duration + raw - offsetMs - this.at(perfNow);
          if (Math.abs(error) > CLOCK_SNAP_MS) {
            basePerf = perfNow;
            baseChart += error;
          } else {
            baseChart += error * CLOCK_SLEW;
          }
        },
        noteAtOrAfter: (t) =>
          loopedNoteAtOrAfter(t, duration, offsetMs, (local, end) =>
            chartNotes ? chartNoteAtOrAfter(chartNotes, local, end) : noteAtOrAfter(local, timing.points, end, grid),
          ),
      };
    };

    const initRhythmLane = () => {
      const lane = document.getElementById("rhythm-lane");
      const stream = lane?.querySelector(".rhythm-stream");
      const judgementLine = document.getElementById("judgement-line");
      const judgementLabel = document.getElementById("rhythm-judgement");
      const resultsDialog = document.getElementById("rhythm-results");
      if (!lane || !stream || !judgementLine || !judgementLabel) return () => {};
      const audio = document.querySelector("[data-music-player] audio");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const modeToggle = document.querySelector("[data-rhythm-mode]");
      const unlockedOnly = Array.from(document.querySelectorAll("[data-unlocked-only]"));
      const optionsDialog = document.getElementById("rhythm-options");
      const isOptionsOpen = () => !!optionsDialog?.open;
      const songPicker = document.querySelector("[data-rhythm-songs]");
      const altKeyHint = document.querySelector("[data-alt-key]");
      const isResultsOpen = () => !!resultsDialog?.open;
      const isPageActive = () =>
        document.visibilityState === "visible" && document.hasFocus() && !isResultsOpen() && !isOptionsOpen();

      let laneWidth = 0;
      let judgementX = 0;
      let speedPxPerMs = 0;
      let phraseIndex = 0;
      let rafId = 0;
      let clearHitTimer = 0;
      let clearJudgeTimer = 0;
      let mode = currentMode();
      let clock = createClock(null, mode);
      let lastChartTime = -Infinity;
      // Built and measured ahead of time; enters the lane when its lead time comes.
      let nextNote = null;

      const notes = [];

      let round = null;
      let lastPressAt = 0;

      const startRound = () => ({
        counts: Object.fromEntries(JUDGEMENTS.map((j) => [j.name, 0])),
        miss: 0,
        combo: 0,
        maxCombo: 0,
        missStreak: 0,
        offsetSum: 0,
        synced: clock.synced,
        mode,
        track: clock.track,
        wholeSong: clock.wholeSong,
        // Started after this pass's E (in the outro)? Then it runs to the next one.
        endAt: clock.wholeSong
          ? clock.endOf(lastChartTime) + (clock.endOf(lastChartTime) <= lastChartTime ? clock.loopLength : 0)
          : Infinity,
      });

      const judgedCount = () =>
        round ? round.miss + Object.values(round.counts).reduce((sum, n) => sum + n, 0) : 0;

      const renderModeToggle = () => {
        const unlocked = isUnlocked();
        const hard = currentMode() === "hard";
        if (altKeyHint) altKeyHint.hidden = !unlocked;
        for (const el of unlockedOnly) el.hidden = !unlocked;
        if (modeToggle) {
          for (const button of modeToggle.querySelectorAll("[data-mode]")) {
            button.setAttribute("aria-pressed", String(button.dataset.mode === currentMode()));
          }
        }
        if (songPicker) {
          songPicker.hidden = !hard;
          for (const button of songPicker.querySelectorAll("[data-song]")) {
            button.setAttribute("aria-pressed", String(button.dataset.song === currentSong()));
          }
        }
      };

      const registerHit = (name, offsetMs) => {
        if (!round) round = startRound();
        round.counts[name] += 1;
        round.combo += 1;
        round.maxCombo = Math.max(round.maxCombo, round.combo);
        round.missStreak = 0;
        round.offsetSum += offsetMs;
      };

      const registerMiss = () => {
        if (!round) return;
        round.miss += 1;
        round.combo = 0;
        round.missStreak += 1;
        if (round.missStreak >= ABANDON_MISS_STREAK && performance.now() - lastPressAt > ABANDON_IDLE_MS) {
          round = null;
        }
      };

      const rankFor = (accuracy) => {
        if (accuracy >= 1) return "SSS";
        if (accuracy >= 0.97) return "SS";
        if (accuracy >= 0.94) return "S";
        if (accuracy >= 0.85) return "A";
        if (accuracy >= 0.7) return "B";
        if (accuracy >= 0.5) return "C";
        return "D";
      };

      let lastAvgOffset = 0;
      let lastRoundWholeSong = false;

      const renderUserOffset = () => {
        const value = resultsDialog.querySelector('[data-rr="user-offset"]');
        if (value) value.textContent = formatMs(readUserOffset());
        const auto = resultsDialog.querySelector('[data-rr="auto"]');
        if (auto) {
          // Late presses (negative average) mean the notes should come later.
          auto.textContent = `Match avg (${formatMs(readUserOffset() - lastAvgOffset)})`;
          auto.disabled = lastAvgOffset === 0;
        }
      };

      const adjustUserOffset = (action) => {
        const current = readUserOffset();
        if (action === "auto") {
          writeUserOffset(current - lastAvgOffset);
          lastAvgOffset = 0;
        } else {
          writeUserOffset(current + Number(action));
        }
        renderUserOffset();
      };

      const fillResults = (r) => {
        const set = (key, value) => {
          const el = resultsDialog.querySelector(`[data-rr="${key}"]`);
          if (el) el.textContent = String(value);
        };
        const hits = Object.values(r.counts).reduce((sum, n) => sum + n, 0);
        const total = hits + r.miss;
        const accuracy = JUDGEMENTS.reduce((sum, j) => sum + r.counts[j.name] * j.weight, 0) / total;
        const avgOffset = hits ? Math.round(r.offsetSum / hits) : 0;

        set("eyebrow", r.mode === "hard" ? `RESULT · HARD · ${timingFor(r.track).title}` : "RESULT");

        const allPerfect = r.counts.CRITICAL + r.counts.PERFECT === total;
        const unlockedNow = allPerfect && !isUnlocked();
        if (unlockedNow) {
          writeStore(UNLOCK_KEY, "1");
          renderModeToggle();
        }
        const unlockBanner = resultsDialog.querySelector("[data-rr-unlock]");
        if (unlockBanner) unlockBanner.hidden = !unlockedNow;

        const rank = rankFor(accuracy);
        const rankEl = resultsDialog.querySelector('[data-rr="rank"]');
        if (rankEl) rankEl.dataset.rank = rank;
        set("rank", rank);
        set("score", Math.round(accuracy * 1000000).toLocaleString("en-US"));
        set("accuracy", (accuracy * 100).toFixed(2));
        for (const j of JUDGEMENTS) set(j.name.toLowerCase(), r.counts[j.name]);
        set("miss", r.miss);
        set("combo", r.maxCombo);
        // Positive offsets mean the press landed before the beat.
        set("offset", avgOffset === 0 ? "±0ms" : `${formatMs(avgOffset)} (${avgOffset > 0 ? "early" : "late"})`);

        // The offset only lines notes up with the music, so offer it when it played.
        lastAvgOffset = avgOffset;
        const calibrate = resultsDialog.querySelector("[data-rr-calibrate]");
        if (calibrate) calibrate.hidden = !r.synced;
        renderUserOffset();

        const badge = resultsDialog.querySelector('[data-rr="badge"]');
        if (badge) {
          const label =
            r.counts.CRITICAL === total ? "ALL CRITICAL"
            : allPerfect ? "ALL PERFECT"
            : r.miss === 0 ? "FULL COMBO"
            : "";
          badge.textContent = label;
          badge.hidden = !label;
        }
      };

      // Returns true when the results screen took over (and stopped the lane).
      const maybeFinishRound = () => {
        if (!round) return false;
        const done = round.wholeSong
          ? lastChartTime >= round.endAt + MISS_MS
          : judgedCount() >= MODES[round.mode].roundNotes;
        if (!done || judgedCount() === 0) return false;
        const finished = round;
        round = null;
        lastRoundWholeSong = finished.wholeSong;

        const rect = lane.getBoundingClientRect();
        const onScreen = rect.bottom > 0 && rect.top < window.innerHeight;
        if (!resultsDialog || !onScreen || document.visibilityState !== "visible") return false;

        fillResults(finished);
        clearLane();
        resultsDialog.showModal();
        return true;
      };

      const clearLane = () => {
        if (pendingBig) {
          window.clearTimeout(pendingBig.timer);
          pendingBig = null;
        }
        window.cancelAnimationFrame(rafId);
        rafId = 0;
        notes.length = 0;
        nextNote = null;
        stream.innerHTML = "";
      };

      const recalcMetrics = () => {
        const laneRect = lane.getBoundingClientRect();
        laneWidth = laneRect.width;
        const judgementRect = judgementLine.getBoundingClientRect();
        judgementX = judgementRect.left - laneRect.left + judgementRect.width * 0.5;
        const config = MODES[mode];
        const crossMs = window.innerWidth < 768 ? config.laneCrossMsMobile : config.laneCrossMs;
        speedPxPerMs = (laneWidth / crossMs) * readSpeed();
      };

      const renderNote = (note, x, fadeIn) => {
        note.x = x;
        const center = x + note.width * 0.5;
        // Narrow (phone) lanes get shorter fades so notes are solid at the line.
        const fade = Math.min(180, laneWidth * 0.22);

        let opacity = 1;
        if (center > laneWidth - fade) {
          opacity = Math.max(0, (laneWidth - center) / fade);
        } else if (center < fade) {
          opacity = Math.max(0, center / fade);
        }

        note.el.style.opacity = String(opacity * fadeIn);
        note.el.style.transform = `translate(${x}px, -55%)`;
      };

      const noteX = (note, chartTime) => judgementX + (note.hitTime - chartTime) * speedPxPerMs - note.width * 0.5;

      // Time before its beat at which a note must appear at the lane's right edge.
      const leadMs = (width) => (laneWidth + 72 - judgementX + width * 0.5) / speedPxPerMs;

      const showJudgement = (name, offsetMs, prefix = "") => {
        const signed = offsetMs > 0 ? "+" + offsetMs : String(offsetMs);
        judgementLabel.textContent = `${prefix}${name} ${signed}ms`;
        judgementLabel.className = `hero-rhythm-judge is-visible ${name.toLowerCase()}`;

        window.clearTimeout(clearJudgeTimer);
        clearJudgeTimer = window.setTimeout(() => {
          judgementLabel.className = "hero-rhythm-judge";
        }, 460);
      };

      const pulseJudgementLine = () => {
        judgementLine.classList.remove("is-hit");
        judgementLine.offsetWidth;
        judgementLine.classList.add("is-hit");

        window.clearTimeout(clearHitTimer);
        clearHitTimer = window.setTimeout(() => {
          judgementLine.classList.remove("is-hit");
        }, 160);
      };

      // Build the next note and pick the first chart slot it fits on. Normal
      // phrases also keep clear of the previous one; hard taps take every slot.
      const planNote = (chartTime, prev) => {
        let el;
        if (mode === "hard") {
          el = buildTapNote(false);
        } else {
          el = buildNoteElement(lanePhrases[phraseIndex % lanePhrases.length]);
          phraseIndex += 1;
        }
        stream.appendChild(el);
        const width = el.offsetWidth;

        const earliest = !prev
          ? chartTime + Math.min(leadMs(width), FIRST_NOTE_LEAD_MS)
          : mode === "hard"
            ? prev.hitTime + 1
            : prev.hitTime + Math.max(MIN_NOTE_INTERVAL_MS, ((prev.width + width) * 0.5 + NOTE_GAP_PX) / speedPxPerMs);
        const hitTime = clock.noteAtOrAfter(earliest);
        const big = mode === "hard" && clock.isBig(hitTime);
        if (big) el.firstElementChild.classList.add("is-big");
        return { el, width: big ? el.offsetWidth : width, x: laneWidth, hitTime, big, hit: false, judged: false };
      };

      const removeNote = (note, hit) => {
        if (note.hit) return;
        note.hit = true;
        note.el.style.setProperty("--note-x", `${note.x}px`);
        note.el.classList.add(hit ? "is-cleared" : "is-missed");
        window.setTimeout(() => {
          note.el.remove();
        }, hit ? 130 : 80);
      };

      const updateNotes = (chartTime) => {
        if (!nextNote) nextNote = planNote(chartTime, notes[notes.length - 1]);
        while (nextNote && chartTime >= nextNote.hitTime - leadMs(nextNote.width)) {
          nextNote.shownAt = chartTime;
          notes.push(nextNote);
          nextNote = planNote(chartTime, nextNote);
        }

        for (let i = notes.length - 1; i >= 0; i -= 1) {
          const note = notes[i];
          if (note.hit) {
            notes.splice(i, 1);
            continue;
          }

          if (!note.judged && chartTime - note.hitTime > MISS_MS) {
            note.judged = true;
            registerMiss();
          }

          const x = noteX(note, chartTime);
          if (x + note.width < -140) {
            removeNote(note, false);
            notes.splice(i, 1);
            continue;
          }

          renderNote(note, x, Math.min(1, (chartTime - note.shownAt) / NOTE_FADE_IN_MS));
        }
      };

      // A big note takes its timing from the first key and waits briefly for
      // the other one: both keys score in full, one key scores a grade lower.
      let pendingBig = null;

      const finishBig = (both) => {
        const pending = pendingBig;
        if (!pending) return;
        pendingBig = null;
        window.clearTimeout(pending.timer);
        const index = JUDGEMENTS.indexOf(pending.judgement);
        const judgement = both ? pending.judgement : JUDGEMENTS[Math.min(JUDGEMENTS.length - 1, index + 1)];
        showJudgement(judgement.name, pending.offset, both ? "BIG " : "");
        registerHit(judgement.name, pending.offset);
        removeNote(pending.note, true);
        maybeFinishRound();
      };

      const triggerHit = (eventTime, key) => {
        if (isResultsOpen() || isOptionsOpen() || !rafId) return;
        lastPressAt = performance.now();
        pulseJudgementLine();

        if (pendingBig) {
          if (key !== pendingBig.key && eventTime - pendingBig.at <= BIG_PAIR_MS) {
            finishBig(true);
            return;
          }
          finishBig(false);
        }

        // Judge against the moment of the press, not the last rendered frame,
        // and take the earliest note still in the window (as in osu!mania), so a
        // late press in a stream doesn't skip a note.
        const chartTime = clock.at(eventTime);
        const best = notes.find((note) => !note.hit && !note.judged && Math.abs(note.hitTime - chartTime) <= MISS_MS);
        if (!best) return;
        const bestOffset = best.hitTime - chartTime;
        const judgement = JUDGEMENTS.find((j) => Math.abs(bestOffset) <= j.ms);

        const roundedOffset = Math.round(bestOffset);
        best.judged = true;
        if (best.big) {
          pendingBig = {
            note: best,
            key,
            at: eventTime,
            judgement,
            offset: roundedOffset,
            timer: window.setTimeout(() => finishBig(false), BIG_PAIR_MS),
          };
          return;
        }
        showJudgement(judgement.name, roundedOffset);
        registerHit(judgement.name, roundedOffset);
        removeNote(best, true);
        maybeFinishRound();
      };

      const onKeyDown = (event) => {
        if (event.repeat) return;
        const key = event.key.toLowerCase();
        const isMain = key === rhythmInputKey.toLowerCase();
        const isAlt = key === altInputKey.toLowerCase() && isUnlocked();
        if (!isMain && !isAlt) return;
        if (isEditableTarget(event.target)) return;

        event.preventDefault();
        triggerHit(event.timeStamp, key);
      };

      const frame = (now) => {
        if (!isPageActive()) {
          clearLane();
          return;
        }
        clock.sync(now);
        // Never let notes step backwards when the clock is nudged back.
        lastChartTime = Math.max(lastChartTime, clock.at(now));
        updateNotes(lastChartTime);
        if (maybeFinishRound()) return;
        rafId = window.requestAnimationFrame(frame);
      };

      const start = () => {
        if (!isPageActive()) return;
        mode = currentMode();
        if (round?.wholeSong) round = null;
        recalcMetrics();
        clearLane();

        if (prefersReducedMotion.matches) {
          const staticNote = buildNoteElement(lanePhrases[0]);
          staticNote.classList.add("rhythm-note-static");
          stream.appendChild(staticNote);
          return;
        }

        clock = createClock(audio, mode);
        lastChartTime = -Infinity;
        rafId = window.requestAnimationFrame(frame);
      };

      const handleActivityChange = () => {
        if (isPageActive()) {
          start();
        } else {
          clearLane();
        }
      };

      // Switching between the song clock and the free-running one moves the beat
      // grid, so start the lane over.
      const onAudioChange = (event) => {
        // "emptied": the player swapped tracks, so the tempo map changed.
        // Looping also fires "seeked", but the clock already follows the wrap,
        // so only seeks started here (restartSong) restart the lane.
        if (event.type === "seeked") {
          if (!restartPending) return;
          restartPending = false;
          handleActivityChange();
        } else if (event.type === "emptied" || clock.synced !== !audio.paused) {
          handleActivityChange();
        }
      };

      // Back to the top of the song (a whole-song hard round starts fresh).
      let restartPending = false;
      const restartSong = () => {
        round = null;
        if (audio && !audio.paused) {
          restartPending = true;
          audio.currentTime = 0;
        }
        handleActivityChange();
      };

      const onModeChange = () => {
        renderModeToggle();
        // The music player handles the same event and swaps tracks if needed.
        restartSong();
      };
      const onModeToggleClick = (event) => {
        const button = event.target.closest?.("[data-mode]");
        if (button && button.dataset.mode !== currentMode()) setMode(button.dataset.mode);
      };
      const onSongClick = (event) => {
        const button = event.target.closest?.("[data-song]");
        if (!button || button.dataset.song === currentSong()) return;
        writeStore(SONG_KEY, button.dataset.song);
        // Same event as a mode change: the player swaps tracks, the lane restarts.
        setMode("hard");
      };
      const restartButton = document.querySelector("[data-rhythm-restart]");
      renderModeToggle();
      modeToggle?.addEventListener("click", onModeToggleClick);
      songPicker?.addEventListener("click", onSongClick);
      restartButton?.addEventListener("click", restartSong);
      window.addEventListener("rhythm-mode", onModeChange);

      const closeResults = () => resultsDialog?.close();
      const onResultsClick = (event) => {
        // Backdrop clicks land on the <dialog> itself.
        const offsetButton = event.target.closest?.("[data-rr-offset]");
        const modeButton = event.target.closest?.("[data-rr-mode]");
        if (offsetButton) adjustUserOffset(offsetButton.dataset.rrOffset);
        else if (modeButton) {
          setMode(modeButton.dataset.rrMode);
          closeResults();
        } else if (event.target === resultsDialog || event.target.closest?.("[data-rr-close]")) closeResults();
      };
      const onResultsClose = () => {
        if (lastRoundWholeSong) {
          lastRoundWholeSong = false;
          restartSong();
        } else {
          round = null;
          handleActivityChange();
        }
      };
      resultsDialog?.addEventListener("click", onResultsClick);
      resultsDialog?.addEventListener("close", onResultsClose);

      const renderOptions = () => {
        if (!optionsDialog) return;
        const speed = readSpeed();
        const slider = optionsDialog.querySelector('[data-ro="speed"]');
        if (slider) slider.value = String(speed);
        const speedValue = optionsDialog.querySelector('[data-ro="speed-value"]');
        if (speedValue) speedValue.textContent = `${speed.toFixed(1)}×`;
        const offsetValue = optionsDialog.querySelector('[data-ro="offset-value"]');
        if (offsetValue) offsetValue.textContent = formatMs(readUserOffset());
      };
      const optionsButton = document.querySelector("[data-rhythm-options-open]");
      const openOptions = () => {
        renderOptions();
        optionsDialog?.showModal();
      };
      const onOptionsInput = (event) => {
        if (event.target.matches?.('[data-ro="speed"]')) {
          writeSpeed(Number(event.target.value));
          renderOptions();
        }
      };
      const onOptionsClick = (event) => {
        const step = event.target.closest?.("[data-ro-offset]");
        if (step) {
          writeUserOffset(readUserOffset() + Number(step.dataset.roOffset));
        } else if (event.target.closest?.("[data-ro-reset]")) {
          writeSpeed(1);
          writeUserOffset(0);
        } else if (event.target === optionsDialog || event.target.closest?.("[data-ro-close]")) {
          optionsDialog.close();
          return;
        }
        renderOptions();
      };
      // Closing applies the new speed/offset by starting the lane over.
      const onOptionsClose = () => handleActivityChange();
      optionsButton?.addEventListener("click", openOptions);
      optionsDialog?.addEventListener("input", onOptionsInput);
      optionsDialog?.addEventListener("click", onOptionsClick);
      optionsDialog?.addEventListener("close", onOptionsClose);

      let disposed = false;
      const fontsReady = "fonts" in document ? document.fonts.ready : Promise.resolve();
      fontsReady.then(() => {
        // Without this check a lane torn down before fonts load would restart
        // and run alongside its replacement (two note streams).
        if (!disposed) handleActivityChange();
      });

      const onResize = () => {
        recalcMetrics();
      };
      window.addEventListener("resize", onResize);
      window.addEventListener("keydown", onKeyDown);
      document.addEventListener("visibilitychange", handleActivityChange);
      window.addEventListener("focus", handleActivityChange);
      window.addEventListener("blur", handleActivityChange);
      audio?.addEventListener("playing", onAudioChange);
      audio?.addEventListener("pause", onAudioChange);
      audio?.addEventListener("seeked", onAudioChange);
      audio?.addEventListener("emptied", onAudioChange);

      const onMobileTap = (e) => {
        e.preventDefault();
        // Each finger counts as its own key, so a two-finger tap hits big notes.
        triggerHit(e.timeStamp, `pointer-${e.pointerId}`);
      };

      const mobileBtn = document.getElementById("mobile-rhythm-btn");
      if (mobileBtn) {
        mobileBtn.addEventListener("pointerdown", onMobileTap);
      }

      return () => {
        disposed = true;
        window.removeEventListener("resize", onResize);
        window.removeEventListener("keydown", onKeyDown);
        document.removeEventListener("visibilitychange", handleActivityChange);
        window.removeEventListener("focus", handleActivityChange);
        window.removeEventListener("blur", handleActivityChange);
        audio?.removeEventListener("playing", onAudioChange);
        audio?.removeEventListener("pause", onAudioChange);
        audio?.removeEventListener("seeked", onAudioChange);
        audio?.removeEventListener("emptied", onAudioChange);
        modeToggle?.removeEventListener("click", onModeToggleClick);
        songPicker?.removeEventListener("click", onSongClick);
        restartButton?.removeEventListener("click", restartSong);
        window.removeEventListener("rhythm-mode", onModeChange);
        if (mobileBtn) {
          mobileBtn.removeEventListener("pointerdown", onMobileTap);
        }
        resultsDialog?.removeEventListener("click", onResultsClick);
        resultsDialog?.removeEventListener("close", onResultsClose);
        optionsButton?.removeEventListener("click", openOptions);
        optionsDialog?.removeEventListener("input", onOptionsInput);
        optionsDialog?.removeEventListener("click", onOptionsClick);
        optionsDialog?.removeEventListener("close", onOptionsClose);
        if (optionsDialog?.open) optionsDialog.close();
        if (resultsDialog?.open) resultsDialog.close();
        window.clearTimeout(clearHitTimer);
        window.clearTimeout(clearJudgeTimer);
        clearLane();
      };
    };

    const unmount = () => {
      window[CLEANUP_KEY]?.();
      window[CLEANUP_KEY] = null;
    };

    const mount = () => {
      unmount();
      window[CLEANUP_KEY] = initRhythmLane();
    };

    mount();
    if (!window.__rhythmLaneBound) {
      window.__rhythmLaneBound = true;
      document.addEventListener("astro:page-load", mount);
      document.addEventListener("astro:before-swap", unmount);
    }
  })();
</script>

