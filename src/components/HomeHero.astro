---
import { withBasePath } from '../utils/withBasePath';
import music from '../data/music.json';

const titleVariants = [
  "Hello!",
  "Welcome!",
  "Hi there!",
  "Greetings!",
  "Hey!"
];

const lanePhrases = titleVariants;
const rhythmInputKey = "F";
const timing = { offsetMs: music.offsetMs, timingPoints: music.timingPoints };
---

<section class="hero min-h-screen hero-tones relative overflow-hidden">
  <div class="hero-aurora" aria-hidden="true"></div>
  <div class="hero-rings" aria-hidden="true"></div>
  <div class="hero-content text-center">
    <div class="max-w-5xl mx-auto space-y-6 px-4">
      <!-- <p class="eyebrow hero-kicker text-sm">{hero.kicker}</p> -->
      <h1 class="hero-title mb-4" aria-label="Welcome, Hello, Hi there, Greetings, Hey">
        <div id="rhythm-lane" class="rhythm-lane" aria-hidden="true">
          <div id="judgement-line" class="judgement-line">
            <span class="judgement-marker judgement-marker-top" aria-hidden="true"></span>
            <span class="judgement-marker judgement-marker-bottom" aria-hidden="true"></span>
            <span class="judgement-tag">JUDGEMENT</span>
          </div>
          <div class="rhythm-stream"></div>
        </div>
      </h1>
      <div class="hero-rhythm-controls-wrapper">
        <p class="hero-rhythm-hint hidden md:block">Press <kbd>{rhythmInputKey}</kbd> to the notes!</p>
        <button id="mobile-rhythm-btn" class="hero-rhythm-tap-btn md:hidden">
          TAP TO THE NOTES!
        </button>
      </div>
      <p id="rhythm-judgement" class="hero-rhythm-judge" aria-live="polite"></p>
      <p class="text-base md:text-lg text-gray-200 hero-subtitle max-w-xl mx-auto leading-relaxed">
        I'm Nathan, a final-year Information Technology student focused on cybersecurity, with active work in cryptography, forensics, red teaming, and software development.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center mt-8 hero-cta px-4 sm:px-0">
        <a href={withBasePath('/blog')} class="btn btn-primary px-8 py-3 text-lg sm:text-xl rounded-xl w-full sm:w-auto">View Blogs</a>
        <a href={withBasePath('/experience')} class="btn btn-outline px-8 py-3 text-lg sm:text-xl rounded-xl transition-all w-full sm:w-auto">Experience</a>
      </div>

      <!-- <div class="hero-meta" data-stagger-group>
        {hero.chips.map((chip) => (
          <span class="meta-chip" data-stagger-item>{chip}</span>
        ))}
      </div> -->
    </div>
  </div>

  <dialog id="rhythm-results" class="rhythm-results" aria-labelledby="rhythm-results-title">
    <div class="rr-card">
      <p class="rr-eyebrow">RESULT</p>
      <div class="rr-rank-row">
        <span class="rr-rank" data-rr="rank">S</span>
        <span class="rr-badge" data-rr="badge" hidden></span>
      </div>
      <h2 id="rhythm-results-title" class="rr-score" data-rr="score">0</h2>
      <p class="rr-accuracy"><span data-rr="accuracy">0.00</span>%</p>
      <dl class="rr-stats">
        <div class="rr-stat critical"><dt>CRITICAL</dt><dd data-rr="critical">0</dd></div>
        <div class="rr-stat perfect"><dt>PERFECT</dt><dd data-rr="perfect">0</dd></div>
        <div class="rr-stat great"><dt>GREAT</dt><dd data-rr="great">0</dd></div>
        <div class="rr-stat good"><dt>GOOD</dt><dd data-rr="good">0</dd></div>
        <div class="rr-stat miss"><dt>MISS</dt><dd data-rr="miss">0</dd></div>
        <div class="rr-stat"><dt>MAX COMBO</dt><dd data-rr="combo">0</dd></div>
      </dl>
      <p class="rr-offset">Avg. timing <span data-rr="offset">±0ms</span></p>
      <button type="button" class="rr-retry btn btn-primary" data-rr-close autofocus>Play again</button>
    </div>
  </dialog>
</section>

<script define:vars={{ rhythmInputKey, lanePhrases, timing }} is:inline>
  (() => {
    // Hit windows (ms either side of the beat), tightest first.
    const JUDGEMENTS = [
      { name: "CRITICAL", ms: 16.67, weight: 1 },
      { name: "PERFECT", ms: 50, weight: 0.95 },
      { name: "GREAT", ms: 90, weight: 0.8 },
      { name: "GOOD", ms: 140, weight: 0.5 },
    ];
    const MISS_MS = JUDGEMENTS[JUDGEMENTS.length - 1].ms;

    // How long a note takes to cross the whole lane.
    const LANE_CROSS_MS = 5600;
    const LANE_CROSS_MS_MOBILE = 4600;
    const NOTE_GAP_PX = 120;
    const MIN_NOTE_INTERVAL_MS = 1850;
    // Notes land on bar lines (every `meter` beats), or every 2nd beat if unset.
    const BEAT_STEP = 2;
    // audio.currentTime is coarse and jittery (badly so in Firefox: it can sit
    // still for a frame, then jump ~250ms), so the song clock runs on
    // performance.now() and is only nudged toward it by a fraction of the error
    // per new reading. Bigger gaps (seek, stall, loop) re-anchor it outright.
    const CLOCK_SLEW = 0.04;
    const CLOCK_SNAP_MS = 300;

    // Results screen: a round starts on the first hit and ends after this many notes.
    const ROUND_NOTES = 10;
    // Give up on a round quietly if the player walked away mid-way.
    const ABANDON_MISS_STREAK = 4;
    const ABANDON_IDLE_MS = 6000;

    // Keep the active lane's cleanup on window so a lane is never mounted twice.
    const CLEANUP_KEY = "__rhythmLaneCleanup";

    const isEditableTarget = (target) =>
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.tagName === "SELECT");

    const buildNoteElement = (text) => {
      const note = document.createElement("span");
      note.className = "rhythm-note";

      const word = document.createElement("span");
      word.className = "rhythm-word";

      const wordRow = document.createElement("span");
      wordRow.className = "rhythm-word-row";
      word.appendChild(wordRow);
      note.appendChild(word);

      for (const char of Array.from(text)) {
        const charNode = document.createElement("span");
        charNode.className = "rhythm-char" + (char === " " ? " is-space" : "");

        const glyph = document.createElement("span");
        glyph.className = "char-glyph";
        glyph.textContent = char;
        charNode.appendChild(glyph);

        wordRow.appendChild(charNode);
      }

      const tap = document.createElement("span");
      tap.className = /[a-z]/i.test(text) ? "tap-note" : "tap-note tap-note-ghost";
      word.appendChild(tap);

      return note;
    };

    const timingPoints = [...timing.timingPoints].sort((a, b) => a.timeMs - b.timeMs);

    // First bar line at or after `t` (ms into the song) within each tempo section. Returns Infinity past the last beat before `end`.
    const beatAtOrAfter = (t, points, end) => {
      for (let i = 0; i < points.length; i += 1) {
        const sectionStart = points[i].timeMs;
        const sectionEnd = Math.min(points[i + 1]?.timeMs ?? Infinity, end);
        if (t >= sectionEnd) continue;
        const step = (60000 / points[i].bpm) * (points[i].meter ?? BEAT_STEP);
        const k = Math.max(0, Math.ceil((t - sectionStart - 0.5) / step));
        const beat = sectionStart + k * step;
        if (beat < sectionEnd) return beat;
      }
      return Infinity;
    };

    // Song clock. While the track plays, chart time follows audio.currentTime
    // (smoothed, see CLOCK_SLEW) and counts loops; otherwise it free-runs at the
    // first section's tempo.
    const createClock = (audio) => {
      const playing = !!audio && !audio.paused && audio.readyState >= 2 && audio.duration > 0;
      if (!playing) {
        const origin = performance.now();
        return {
          synced: false,
          at: (perfNow) => perfNow - origin,
          sync: () => {},
          beatAtOrAfter: (t) => beatAtOrAfter(t, [{ ...timingPoints[0], timeMs: 0 }], Infinity),
        };
      }

      const duration = audio.duration * 1000;
      let loops = 0;
      let lastRaw = audio.currentTime * 1000;
      let basePerf = performance.now();
      let baseChart = lastRaw - timing.offsetMs;

      return {
        synced: true,
        at: (perfNow) => baseChart + (perfNow - basePerf) * audio.playbackRate,
        sync(perfNow) {
          const raw = audio.currentTime * 1000;
          // A repeated value is a stale reading, not the song standing still.
          if (raw === lastRaw) return;
          if (raw < lastRaw - duration / 2) loops += 1;
          lastRaw = raw;
          const error = loops * duration + raw - timing.offsetMs - this.at(perfNow);
          if (Math.abs(error) > CLOCK_SNAP_MS) {
            basePerf = perfNow;
            baseChart += error;
          } else {
            baseChart += error * CLOCK_SLEW;
          }
        },
        beatAtOrAfter(t) {
          // Chart time keeps growing across loops; map into the current loop.
          const shifted = t + timing.offsetMs;
          const loop = Math.floor(shifted / duration);
          const local = shifted - loop * duration;
          let beat = beatAtOrAfter(local, timingPoints, duration);
          let base = loop * duration;
          if (beat === Infinity) {
            base += duration;
            beat = beatAtOrAfter(0, timingPoints, duration);
          }
          return base + beat - timing.offsetMs;
        },
      };
    };

    const initRhythmLane = () => {
      const lane = document.getElementById("rhythm-lane");
      const stream = lane?.querySelector(".rhythm-stream");
      const judgementLine = document.getElementById("judgement-line");
      const judgementLabel = document.getElementById("rhythm-judgement");
      const resultsDialog = document.getElementById("rhythm-results");
      if (!lane || !stream || !judgementLine || !judgementLabel) return () => {};
      const audio = document.querySelector("[data-music-player] audio");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const isResultsOpen = () => !!resultsDialog?.open;
      const isPageActive = () =>
        document.visibilityState === "visible" && document.hasFocus() && !isResultsOpen();

      let laneWidth = 0;
      let judgementX = 0;
      let speedPxPerMs = 0;
      let phraseIndex = 0;
      let rafId = 0;
      let clearHitTimer = 0;
      let clearJudgeTimer = 0;
      let clock = createClock(null);
      let lastChartTime = -Infinity;
      // Built and measured ahead of time; enters the lane when its lead time comes.
      let nextNote = null;

      const notes = [];

      let round = null;
      let lastPressAt = 0;

      const startRound = () => ({
        counts: Object.fromEntries(JUDGEMENTS.map((j) => [j.name, 0])),
        miss: 0,
        combo: 0,
        maxCombo: 0,
        missStreak: 0,
        offsetSum: 0,
      });

      const judgedCount = () =>
        round ? round.miss + Object.values(round.counts).reduce((sum, n) => sum + n, 0) : 0;

      const registerHit = (name, offsetMs) => {
        if (!round) round = startRound();
        round.counts[name] += 1;
        round.combo += 1;
        round.maxCombo = Math.max(round.maxCombo, round.combo);
        round.missStreak = 0;
        round.offsetSum += offsetMs;
      };

      const registerMiss = () => {
        if (!round) return;
        round.miss += 1;
        round.combo = 0;
        round.missStreak += 1;
        if (round.missStreak >= ABANDON_MISS_STREAK && performance.now() - lastPressAt > ABANDON_IDLE_MS) {
          round = null;
        }
      };

      const rankFor = (accuracy) => {
        if (accuracy >= 1) return "SSS";
        if (accuracy >= 0.97) return "SS";
        if (accuracy >= 0.94) return "S";
        if (accuracy >= 0.85) return "A";
        if (accuracy >= 0.7) return "B";
        if (accuracy >= 0.5) return "C";
        return "D";
      };

      const fillResults = (r) => {
        const set = (key, value) => {
          const el = resultsDialog.querySelector(`[data-rr="${key}"]`);
          if (el) el.textContent = String(value);
        };
        const hits = Object.values(r.counts).reduce((sum, n) => sum + n, 0);
        const total = hits + r.miss;
        const accuracy = JUDGEMENTS.reduce((sum, j) => sum + r.counts[j.name] * j.weight, 0) / total;
        const avgOffset = hits ? Math.round(r.offsetSum / hits) : 0;

        const rank = rankFor(accuracy);
        const rankEl = resultsDialog.querySelector('[data-rr="rank"]');
        if (rankEl) rankEl.dataset.rank = rank;
        set("rank", rank);
        set("score", Math.round(accuracy * 1000000).toLocaleString("en-US"));
        set("accuracy", (accuracy * 100).toFixed(2));
        for (const j of JUDGEMENTS) set(j.name.toLowerCase(), r.counts[j.name]);
        set("miss", r.miss);
        set("combo", r.maxCombo);
        // Positive offsets mean the press landed before the beat.
        set("offset", avgOffset === 0 ? "±0ms" : `${avgOffset > 0 ? "+" : ""}${avgOffset}ms (${avgOffset > 0 ? "early" : "late"})`);

        const badge = resultsDialog.querySelector('[data-rr="badge"]');
        if (badge) {
          const label =
            r.counts.CRITICAL === total ? "ALL CRITICAL"
            : r.counts.CRITICAL + r.counts.PERFECT === total ? "ALL PERFECT"
            : r.miss === 0 ? "FULL COMBO"
            : "";
          badge.textContent = label;
          badge.hidden = !label;
        }
      };

      // Returns true when the results screen took over (and stopped the lane).
      const maybeFinishRound = () => {
        if (!round || judgedCount() < ROUND_NOTES) return false;
        const finished = round;
        round = null;

        const rect = lane.getBoundingClientRect();
        const onScreen = rect.bottom > 0 && rect.top < window.innerHeight;
        if (!resultsDialog || !onScreen || document.visibilityState !== "visible") return false;

        fillResults(finished);
        clearLane();
        resultsDialog.showModal();
        return true;
      };

      const clearLane = () => {
        window.cancelAnimationFrame(rafId);
        rafId = 0;
        notes.length = 0;
        nextNote = null;
        stream.innerHTML = "";
      };

      const recalcMetrics = () => {
        const laneRect = lane.getBoundingClientRect();
        laneWidth = laneRect.width;
        const judgementRect = judgementLine.getBoundingClientRect();
        judgementX = judgementRect.left - laneRect.left + judgementRect.width * 0.5;
        speedPxPerMs = laneWidth / (window.innerWidth < 768 ? LANE_CROSS_MS_MOBILE : LANE_CROSS_MS);
      };

      const renderNote = (note, x) => {
        note.x = x;
        const center = x + note.width * 0.5;
        const rightFadeStart = laneWidth - 180;
        const leftFadeEnd = 180;

        let opacity = 1;
        if (center > rightFadeStart) {
          opacity = Math.max(0, (laneWidth - center) / 180);
        } else if (center < leftFadeEnd) {
          opacity = Math.max(0, center / 180);
        }

        note.el.style.opacity = String(opacity);
        note.el.style.transform = `translate(${x}px, -55%)`;
      };

      const noteX = (note, chartTime) => judgementX + (note.hitTime - chartTime) * speedPxPerMs - note.width * 0.5;

      // Time before its beat at which a note must appear at the lane's right edge.
      const leadMs = (width) => (laneWidth + 72 - judgementX + width * 0.5) / speedPxPerMs;

      const showJudgement = (name, offsetMs) => {
        const signed = offsetMs > 0 ? "+" + offsetMs : String(offsetMs);
        judgementLabel.textContent = `${name} ${signed}ms`;
        judgementLabel.className = `hero-rhythm-judge is-visible ${name.toLowerCase()}`;

        window.clearTimeout(clearJudgeTimer);
        clearJudgeTimer = window.setTimeout(() => {
          judgementLabel.className = "hero-rhythm-judge";
        }, 460);
      };

      const pulseJudgementLine = () => {
        judgementLine.classList.remove("is-hit");
        judgementLine.offsetWidth;
        judgementLine.classList.add("is-hit");

        window.clearTimeout(clearHitTimer);
        clearHitTimer = window.setTimeout(() => {
          judgementLine.classList.remove("is-hit");
        }, 160);
      };

      // Build the next phrase and pick the first beat it fits on without
      // crowding the previous note.
      const planNote = (chartTime, prev) => {
        const phrase = lanePhrases[phraseIndex % lanePhrases.length];
        phraseIndex += 1;

        const el = buildNoteElement(phrase);
        stream.appendChild(el);
        const width = el.offsetWidth;

        const earliest = prev
          ? prev.hitTime + Math.max(MIN_NOTE_INTERVAL_MS, ((prev.width + width) * 0.5 + NOTE_GAP_PX) / speedPxPerMs)
          : chartTime + leadMs(width);
        return { el, width, x: laneWidth, hitTime: clock.beatAtOrAfter(earliest), hit: false, judged: false };
      };

      const removeNote = (note, hit) => {
        if (note.hit) return;
        note.hit = true;
        note.el.style.setProperty("--note-x", `${note.x}px`);
        note.el.classList.add(hit ? "is-cleared" : "is-missed");
        window.setTimeout(() => {
          note.el.remove();
        }, hit ? 130 : 80);
      };

      const updateNotes = (chartTime) => {
        if (!nextNote) nextNote = planNote(chartTime, notes[notes.length - 1]);
        while (nextNote && chartTime >= nextNote.hitTime - leadMs(nextNote.width)) {
          notes.push(nextNote);
          nextNote = planNote(chartTime, nextNote);
        }

        for (let i = notes.length - 1; i >= 0; i -= 1) {
          const note = notes[i];
          if (note.hit) {
            notes.splice(i, 1);
            continue;
          }

          if (!note.judged && chartTime - note.hitTime > MISS_MS) {
            note.judged = true;
            registerMiss();
          }

          const x = noteX(note, chartTime);
          if (x + note.width < -140) {
            removeNote(note, false);
            notes.splice(i, 1);
            continue;
          }

          renderNote(note, x);
        }
      };

      const triggerHit = (eventTime) => {
        if (isResultsOpen() || !rafId) return;
        lastPressAt = performance.now();
        pulseJudgementLine();

        // Judge against the moment of the press, not the last rendered frame.
        const chartTime = clock.at(eventTime);
        let best = null;
        let bestOffset = Infinity;
        for (const note of notes) {
          if (note.hit || note.judged) continue;
          const offset = note.hitTime - chartTime;
          if (Math.abs(offset) < Math.abs(bestOffset)) {
            best = note;
            bestOffset = offset;
          }
        }
        const judgement = best && JUDGEMENTS.find((j) => Math.abs(bestOffset) <= j.ms);
        if (!judgement) return;

        const roundedOffset = Math.round(bestOffset);
        best.judged = true;
        showJudgement(judgement.name, roundedOffset);
        registerHit(judgement.name, roundedOffset);
        removeNote(best, true);
        maybeFinishRound();
      };

      const onKeyDown = (event) => {
        if (event.repeat) return;
        if (event.key.toLowerCase() !== rhythmInputKey.toLowerCase()) return;
        if (isEditableTarget(event.target)) return;

        event.preventDefault();
        triggerHit(event.timeStamp);
      };

      const frame = (now) => {
        if (!isPageActive()) {
          clearLane();
          return;
        }
        clock.sync(now);
        // Never let notes step backwards when the clock is nudged back.
        lastChartTime = Math.max(lastChartTime, clock.at(now));
        updateNotes(lastChartTime);
        if (maybeFinishRound()) return;
        rafId = window.requestAnimationFrame(frame);
      };

      const start = () => {
        if (!isPageActive()) return;
        recalcMetrics();
        clearLane();

        if (prefersReducedMotion.matches) {
          const staticNote = buildNoteElement(lanePhrases[0]);
          staticNote.classList.add("rhythm-note-static");
          stream.appendChild(staticNote);
          return;
        }

        clock = createClock(audio);
        lastChartTime = -Infinity;
        rafId = window.requestAnimationFrame(frame);
      };

      const handleActivityChange = () => {
        if (isPageActive()) {
          start();
        } else {
          clearLane();
        }
      };

      // Switching between the song clock and the free-running one moves the beat
      // grid, so start the lane over.
      const onAudioChange = () => {
        if (clock.synced !== !audio.paused || audio.seeking) handleActivityChange();
      };

      const closeResults = () => resultsDialog?.close();
      const onResultsClick = (event) => {
        // Backdrop clicks land on the <dialog> itself.
        if (event.target === resultsDialog || event.target.closest?.("[data-rr-close]")) closeResults();
      };
      const onResultsClose = () => {
        round = null;
        handleActivityChange();
      };
      resultsDialog?.addEventListener("click", onResultsClick);
      resultsDialog?.addEventListener("close", onResultsClose);

      let disposed = false;
      const fontsReady = "fonts" in document ? document.fonts.ready : Promise.resolve();
      fontsReady.then(() => {
        // Without this check a lane torn down before fonts load would restart
        // and run alongside its replacement (two note streams).
        if (!disposed) handleActivityChange();
      });

      const onResize = () => {
        recalcMetrics();
      };
      window.addEventListener("resize", onResize);
      window.addEventListener("keydown", onKeyDown);
      document.addEventListener("visibilitychange", handleActivityChange);
      window.addEventListener("focus", handleActivityChange);
      window.addEventListener("blur", handleActivityChange);
      audio?.addEventListener("playing", onAudioChange);
      audio?.addEventListener("pause", onAudioChange);
      audio?.addEventListener("seeked", onAudioChange);

      const onMobileTap = (e) => {
        e.preventDefault();
        triggerHit(e.timeStamp);
      };

      const mobileBtn = document.getElementById("mobile-rhythm-btn");
      if (mobileBtn) {
        mobileBtn.addEventListener("pointerdown", onMobileTap);
      }

      return () => {
        disposed = true;
        window.removeEventListener("resize", onResize);
        window.removeEventListener("keydown", onKeyDown);
        document.removeEventListener("visibilitychange", handleActivityChange);
        window.removeEventListener("focus", handleActivityChange);
        window.removeEventListener("blur", handleActivityChange);
        audio?.removeEventListener("playing", onAudioChange);
        audio?.removeEventListener("pause", onAudioChange);
        audio?.removeEventListener("seeked", onAudioChange);
        if (mobileBtn) {
          mobileBtn.removeEventListener("pointerdown", onMobileTap);
        }
        resultsDialog?.removeEventListener("click", onResultsClick);
        resultsDialog?.removeEventListener("close", onResultsClose);
        if (resultsDialog?.open) resultsDialog.close();
        window.clearTimeout(clearHitTimer);
        window.clearTimeout(clearJudgeTimer);
        clearLane();
      };
    };

    const unmount = () => {
      window[CLEANUP_KEY]?.();
      window[CLEANUP_KEY] = null;
    };

    const mount = () => {
      unmount();
      window[CLEANUP_KEY] = initRhythmLane();
    };

    mount();
    if (!window.__rhythmLaneBound) {
      window.__rhythmLaneBound = true;
      document.addEventListener("astro:page-load", mount);
      document.addEventListener("astro:before-swap", unmount);
    }
  })();
</script>

<style>
  .hero-tones {
    position: relative;
    isolation: isolate;
    background: radial-gradient(circle at 20% 20%, rgba(122, 162, 247, 0.18), transparent 35%),
      radial-gradient(circle at 80% 10%, rgba(187, 154, 247, 0.16), transparent 35%),
      radial-gradient(circle at 50% 85%, rgba(125, 207, 255, 0.12), transparent 38%),
      var(--tokyo-surface);
  }

  .hero-aurora {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    background: radial-gradient(circle at 30% 40%, rgba(122, 162, 247, 0.35), transparent 55%),
      radial-gradient(circle at 70% 30%, rgba(187, 154, 247, 0.25), transparent 50%),
      radial-gradient(circle at 50% 60%, rgba(125, 207, 255, 0.18), transparent 55%);
    filter: blur(48px);
    opacity: 0.8;
    z-index: 0;
  }

  .hero-rings {
    position: absolute;
    inset: 8% 10% auto 10%;
    height: 70%;
    background: radial-gradient(circle, rgba(192, 202, 245, 0.08) 0%, transparent 55%);
    border-radius: 50%;
    filter: blur(18px);
    opacity: 0.65;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 100%;
    width: 100%;
  }

  .hero-kicker {
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: rgba(192, 202, 245, 0.7);
  }

  .hero-title {
    margin-left: auto;
    margin-right: auto;
    max-width: 78rem;
  }

  .rhythm-lane {
    position: relative;
    overflow: hidden;
    border-radius: 1.2rem;
    border: 1px solid rgba(122, 162, 247, 0.28);
