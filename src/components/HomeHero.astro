  }

  .judge-hit-gate {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    transform: translate(-50%, -50%);
    opacity: 0.28;
    transition: opacity 120ms ease, transform 120ms ease;
    color: rgba(125, 207, 255, 0.92);
    text-shadow: 0 0 8px rgba(125, 207, 255, 0.6);
  }

  .judge-arrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
  }

  .judge-arrow-up {
    transform: translateY(0.04rem);
  }

  .judge-arrow-down {
    transform: translateY(-0.04rem);
  }

  .judge-hit-bar {
    width: 0.95rem;
    height: 0.15rem;
    border-radius: 99px;
    background: rgba(125, 207, 255, 0.9);
    box-shadow: 0 0 10px rgba(125, 207, 255, 0.7);
  }

  .judgement-line.is-hit .judge-hit-gate {
    opacity: 1;
    animation: judge-hit-gate-pulse 180ms ease-out;
  }

  .rhythm-stream {
    position: relative;
    height: clamp(3.4rem, 8vw, 6rem);
  }

  :global(.rhythm-note) {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate(0, -55%);
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  :global(.rhythm-note-static) {
    left: 5%;
    opacity: 0.82;
    transform: translate(0, -55%);
  }

  :global(.rhythm-note.is-cleared) {
    opacity: 0 !important;
    filter: blur(2px);
    transform: translate(var(--note-x, 0px), -55%) scale(0.9);
  }

  :global(.rhythm-note.is-missed) {
    opacity: 0 !important;
  }

  :global(.rhythm-word) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    white-space: nowrap;
  }

  :global(.rhythm-word-row) {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.1rem;
  }

  :global(.rhythm-char) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-width: clamp(1.8rem, 2.3vw, 2.8rem);
    line-height: 0.9;
    gap: 0.7rem;
  }

  :global(.rhythm-char.is-space) {
    min-width: clamp(0.9rem, 1.5vw, 1.2rem);
  }

  :global(.char-glyph) {
    font-size: clamp(2rem, 6vw, 4.4rem);
    font-weight: 800;
    color: rgba(147, 197, 253, 0.95);
    text-shadow: 0 0 20px rgba(125, 207, 255, 0.45);
    font-family: "JetBrains Mono", monospace;
  }

  :global(.tap-note) {
    width: clamp(0.5rem, 1.1vw, 0.78rem);
    height: clamp(0.5rem, 1.1vw, 0.78rem);
    border-radius: 999px;
    border: 2px solid rgba(125, 207, 255, 0.95);
    background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.9), rgba(122, 162, 247, 0.9));
    box-shadow: 0 0 12px rgba(125, 207, 255, 0.8);
    margin-top: 0.78rem;
  }

  :global(.tap-note-ghost) {
    opacity: 0;
  }

  .hero-rhythm-hint {
    margin: 0.3rem auto 0;
    color: rgba(192, 202, 245, 0.82);
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    animation: hero-rhythm-hint-fade 2.4s ease-in-out infinite;
  }

  .hero-rhythm-judge {
    margin: 0.05rem auto 0;
    min-height: 1.1rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    font-family: "JetBrains Mono", monospace;
    opacity: 0;
    transform: translateY(0.25rem);
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .hero-rhythm-judge.is-visible {
    opacity: 0.95;
    transform: translateY(0);
  }

  .hero-rhythm-judge.perfect {
    color: rgba(125, 255, 197, 0.95);
    text-shadow: 0 0 12px rgba(125, 255, 197, 0.5);
  }

  .hero-rhythm-judge.critical {
    color: #ffd27a;
    text-shadow: 0 0 14px rgba(224, 175, 104, 0.6);
  }

  .hero-rhythm-judge.great {
    color: rgba(125, 207, 255, 0.95);
    text-shadow: 0 0 12px rgba(125, 207, 255, 0.45);
  }

  .hero-rhythm-judge.good {
    color: rgba(187, 154, 247, 0.95);
    text-shadow: 0 0 12px rgba(187, 154, 247, 0.45);
  }

  .hero-rhythm-hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0.04rem 0.34rem;
    margin: 0 0.15rem;
    border-radius: 0.38rem;
    border: 1px solid rgba(122, 162, 247, 0.6);
    background: rgba(20, 24, 37, 0.78);
    color: rgba(125, 207, 255, 0.96);
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
  }

  @keyframes judge-hit-gate-pulse {
    0% {
      transform: translate(-50%, -50%) scale(0.9);
      filter: blur(1px);
    }
    100% {
      transform: translate(-50%, -50%) scale(1.08);
      filter: blur(0);
    }
  }

  @keyframes hero-rhythm-hint-fade {
    0%,
    100% {
      opacity: 0.34;
    }
    50% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rhythm-hint {
      animation: none;
      opacity: 0.9;
    }
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .meta-chip {
    padding: 0.65rem 0.95rem;
    border-radius: 999px;
    background: rgba(36, 40, 59, 0.78);
    border: 1px solid rgba(122, 162, 247, 0.35);
    color: rgba(192, 202, 245, 0.9);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(10px);
  }

  .hero-rhythm-tap-btn {
    display: none;
    margin: 0.5rem auto 0;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    background: rgba(122, 162, 247, 0.15);
    border: 1px solid rgba(122, 162, 247, 0.4);
    color: rgba(125, 207, 255, 0.95);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    backdrop-filter: blur(4px);
    transition: all 0.2s ease;
    animation: hero-rhythm-hint-fade 2.4s ease-in-out infinite;
    align-items: center;
    justify-content: center;
  }

  .hero-rhythm-tap-btn:active {
    transform: scale(0.95);
    background: rgba(122, 162, 247, 0.3);
  }

  /* Difficulty toggle (shown once hard mode is unlocked) */
  .rhythm-mode {
    display: inline-flex;
    padding: 0.2rem;
    border-radius: 999px;
    border: 1px solid rgba(122, 162, 247, 0.3);
    background: rgba(20, 24, 37, 0.6);
    font-family: "JetBrains Mono", "Fira Code", monospace;
  }

  .rhythm-mode[hidden],
  .rhythm-restart[hidden],
  .rhythm-songs[hidden] {
    display: none;
  }

  .ro-card {
    text-align: left;
  }

  .ro-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--tokyo-contrast, #c0caf5);
  }

  .ro-label {
    display: flex;
    justify-content: space-between;
    letter-spacing: 0.06em;
  }

  .ro-label output {
    font-weight: 700;
    color: #7dcfff;
  }

  .ro-field input[type="range"] {
    accent-color: #7aa2f7;
  }

  .ro-stepper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ro-help {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgba(169, 177, 214, 0.7);
  }

  .ro-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }

  .ro-done {
    flex: 1;
    border-radius: 0.75rem;
  }

  :global(html.light) .ro-field {
    color: #2f3550;
  }

  :global(html.light) .ro-label output {
    color: #1d63a8;
  }

  :global(html.light) .ro-help {
    color: rgba(59, 66, 97, 0.75);
  }

  .rhythm-mode-row {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .rhythm-restart {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(122, 162, 247, 0.3);
    background: rgba(20, 24, 37, 0.6);
    color: rgba(192, 202, 245, 0.75);
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .rhythm-restart:hover {
    color: #7dcfff;
    border-color: rgba(122, 162, 247, 0.6);
  }

  .rhythm-songs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.5rem auto 0;
    font-family: "JetBrains Mono", "Fira Code", monospace;
  }

  .rhythm-songs button {
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 158, 100, 0.25);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: rgba(192, 202, 245, 0.65);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .rhythm-songs button[aria-pressed="true"] {
    border-color: rgba(255, 158, 100, 0.6);
    background: rgba(255, 158, 100, 0.15);
    color: #ff9e64;
  }

  .rhythm-mode button {
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(192, 202, 245, 0.65);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .rhythm-mode button[aria-pressed="true"] {
    background: rgba(122, 162, 247, 0.22);
    color: #7dcfff;
  }

  .rhythm-mode button[data-mode="hard"][aria-pressed="true"] {
    background: rgba(255, 158, 100, 0.2);
    color: #ff9e64;
  }

  /* Hard-mode tap notes */
  :global(.hard-note.is-big) {
    width: clamp(1.9rem, 3.8vw, 2.9rem);
    height: clamp(1.9rem, 3.8vw, 2.9rem);
    border-width: 4px;
    border-color: #f7768e;
    background: radial-gradient(circle at 35% 35%, #ffe4e8, #f7768e 70%);
    box-shadow: 0 0 18px rgba(247, 118, 142, 0.8);
  }

  :global(.hard-note) {
    display: block;
    width: clamp(1.2rem, 2.4vw, 1.9rem);
    height: clamp(1.2rem, 2.4vw, 1.9rem);
    border-radius: 999px;
    border: 3px solid #ff9e64;
    background: radial-gradient(circle at 35% 35%, #fff4e6, #ff9e64 70%);
    box-shadow: 0 0 14px rgba(255, 158, 100, 0.75);
  }


  /* Results screen */
  .rhythm-results {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    max-width: min(26rem, calc(100vw - 2rem));
    width: 100%;
  }

  .rhythm-results::backdrop {
    background: rgba(10, 12, 20, 0.62);
    backdrop-filter: blur(4px);
  }

  .rhythm-results[open] .rr-card {
    animation: rr-card-in 420ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  .rhythm-results[open] .rr-rank {
    animation: rr-rank-in 520ms 120ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }

  .rr-card {
    position: relative;
    overflow: hidden;
    padding: 1.6rem 1.5rem 1.4rem;
    border-radius: 1.2rem;
    border: 1px solid rgba(122, 162, 247, 0.35);
    background: linear-gradient(180deg, rgba(36, 40, 59, 0.96), rgba(20, 24, 37, 0.97));
    box-shadow: inset 0 0 40px rgba(122, 162, 247, 0.08), 0 24px 60px rgba(0, 0, 0, 0.5);
    text-align: center;
    font-family: "JetBrains Mono", "Fira Code", monospace;
  }

  .rr-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(125, 207, 255, 0.95), transparent);
    box-shadow: 0 0 18px rgba(125, 207, 255, 0.7);
  }

  .rr-eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    color: rgba(192, 202, 245, 0.7);
  }

  .rr-rank-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .rr-rank {
    font-size: 4.2rem;
    font-weight: 800;
    line-height: 1;
    font-style: italic;
    /* Room for the italic overhang: background-clip: text only paints inside the box. */
    padding: 0.04em 0.14em 0.04em 0.06em;
    color: rgba(147, 197, 253, 0.95);
    text-shadow: 0 0 24px rgba(125, 207, 255, 0.5);
  }

  .rr-rank[data-rank="SSS"],
  .rr-rank[data-rank="SS"],
  .rr-rank[data-rank="S"] {
    background: linear-gradient(180deg, #ffe7a3, #e0af68 55%, #ff9e64);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 0 14px rgba(224, 175, 104, 0.45));
  }

  .rr-rank[data-rank="C"],
  .rr-rank[data-rank="D"] {
    color: rgba(169, 177, 214, 0.75);
    text-shadow: none;
  }

  .rr-badge {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(125, 255, 197, 0.55);
    color: rgba(125, 255, 197, 0.95);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    box-shadow: 0 0 14px rgba(125, 255, 197, 0.25);
  }

  .rr-score {
    margin-top: 0.6rem;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #c0caf5;
    font-variant-numeric: tabular-nums;
  }

  .rr-accuracy {
    font-size: 0.95rem;
    color: rgba(125, 207, 255, 0.95);
    font-variant-numeric: tabular-nums;
  }

  .rr-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }

  .rr-stat {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
    background: rgba(122, 162, 247, 0.08);
    border: 1px solid rgba(122, 162, 247, 0.16);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(192, 202, 245, 0.8);
  }

  .rr-stat dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #c0caf5;
    font-variant-numeric: tabular-nums;
  }

  .rr-stat.perfect dt {
    color: rgba(125, 255, 197, 0.95);
  }

  .rr-stat.critical dt {
    color: #ffd27a;
  }

  .rr-stat.great dt {
    color: rgba(125, 207, 255, 0.95);
  }

  .rr-stat.good dt {
    color: rgba(187, 154, 247, 0.95);
  }

  .rr-stat.miss dt {
    color: rgba(247, 118, 142, 0.95);
  }

  .rr-offset {
    margin-top: 0.85rem;
    font-size: 0.74rem;
    color: rgba(192, 202, 245, 0.65);
  }

  .rr-calibrate {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: 0.74rem;
    color: rgba(192, 202, 245, 0.75);
  }

  .rr-calibrate[hidden] {
    display: none;
  }

  .rr-calibrate-label {
    margin-right: 0.15rem;
    letter-spacing: 0.08em;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: help;
  }

  .rr-calibrate-value {
    min-width: 3.6rem;
    font-weight: 700;
    color: #c0caf5;
    font-variant-numeric: tabular-nums;
  }

  .rr-step,
  .rr-auto {
    height: 1.8rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(122, 162, 247, 0.3);
    background: rgba(122, 162, 247, 0.1);
    color: #7dcfff;
    font-family: inherit;
    transition: background-color 150ms ease;
  }

  .rr-step {
    width: 1.8rem;
    font-size: 1rem;
    line-height: 1;
  }

  .rr-auto {
    padding: 0 0.6rem;
    font-size: 0.7rem;
  }

  .rr-step:hover,
  .rr-auto:hover:not(:disabled) {
    background: rgba(122, 162, 247, 0.22);
  }

  .rr-auto:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .rr-unlock {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255, 158, 100, 0.45);
    background: rgba(255, 158, 100, 0.08);
    box-shadow: 0 0 22px rgba(255, 158, 100, 0.15);
  }

  .rr-unlock[hidden] {
    display: none;
  }

  .rhythm-results[open] .rr-unlock:not([hidden]) {
    animation: rr-rank-in 520ms 300ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }

  .rr-unlock-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #ff9e64;
  }

  .rr-unlock-text {
    margin-top: 0.3rem;
    font-size: 0.74rem;
    line-height: 1.5;
    color: rgba(192, 202, 245, 0.8);
  }

  .rr-unlock-text kbd {
    padding: 0 0.3rem;
    border-radius: 0.3rem;
    border: 1px solid rgba(255, 158, 100, 0.5);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    color: #ff9e64;
  }

  .rr-unlock-btn {
    margin-top: 0.6rem;
    padding: 0.4rem 1rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(255, 158, 100, 0.6);
    color: #ff9e64;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    transition: background-color 150ms ease;
  }

  .rr-unlock-btn:hover {
    background: rgba(255, 158, 100, 0.15);
  }

  .rr-retry {
    margin-top: 1.1rem;
    width: 100%;
    border-radius: 0.75rem;
  }

  @keyframes rr-card-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
  }

  @keyframes rr-rank-in {
    from {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rhythm-results[open] .rr-card,
    .rhythm-results[open] .rr-rank {
      animation: none;
    }
  }

  /* Light theme */
  :global(html.light) .rhythm-results::backdrop {
    background: rgba(52, 59, 88, 0.35);
  }

  :global(html.light) .rr-card {
    border-color: rgba(42, 91, 184, 0.25);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.97), rgba(236, 238, 245, 0.98));
    box-shadow: 0 24px 60px rgba(52, 59, 88, 0.22);
  }

  :global(html.light) .rr-card::before {
    background: linear-gradient(90deg, transparent, rgba(0, 106, 142, 0.85), transparent);
    box-shadow: none;
  }

  :global(html.light) .rr-eyebrow,
  :global(html.light) .rr-offset,
  :global(html.light) .rr-stat {
    color: rgba(59, 66, 97, 0.8);
  }

  :global(html.light) .rr-rank {
    color: #2a5bb8;
    text-shadow: none;
  }

  :global(html.light) .rr-rank[data-rank="SSS"],
  :global(html.light) .rr-rank[data-rank="SS"],
  :global(html.light) .rr-rank[data-rank="S"] {
    background: linear-gradient(180deg, #d9a43a, #b5651d);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: none;
  }

  :global(html.light) .rr-rank[data-rank="C"],
  :global(html.light) .rr-rank[data-rank="D"] {
    color: #6172b0;
  }

  :global(html.light) .rr-badge {
    border-color: rgba(29, 122, 79, 0.5);
    color: #1d7a4f;
    box-shadow: none;
  }

  :global(html.light) .rr-score,
  :global(html.light) .rr-stat dd {
    color: #2f3550;
  }

  :global(html.light) .rhythm-mode {
    border-color: rgba(42, 91, 184, 0.25);
    background: rgba(255, 255, 255, 0.7);
  }

  :global(html.light) .rhythm-restart {
    border-color: rgba(42, 91, 184, 0.25);
    background: rgba(255, 255, 255, 0.7);
    color: rgba(59, 66, 97, 0.75);
  }

  :global(html.light) .rhythm-songs button {
    border-color: rgba(177, 92, 0, 0.25);
    color: rgba(59, 66, 97, 0.7);
  }

  :global(html.light) .rhythm-songs button[aria-pressed="true"] {
    border-color: rgba(177, 92, 0, 0.5);
    background: rgba(177, 92, 0, 0.1);
    color: #b15c00;
  }

  :global(html.light) .rhythm-mode button {
    color: rgba(59, 66, 97, 0.65);
  }

  :global(html.light) .rhythm-mode button[aria-pressed="true"] {
    background: rgba(42, 91, 184, 0.12);
    color: #2a5bb8;
  }

  :global(html.light) .rhythm-mode button[data-mode="hard"][aria-pressed="true"] {
    background: rgba(177, 92, 0, 0.12);
    color: #b15c00;
  }

  :global(html.light .hard-note.is-big) {
    border-color: #c4314b;
    background: radial-gradient(circle at 35% 35%, #fff, #e8798c 70%);
    box-shadow: 0 0 12px rgba(196, 49, 75, 0.45);
  }

  :global(html.light .hard-note) {
    border-color: #d16d00;
    background: radial-gradient(circle at 35% 35%, #fff, #f0a050 70%);
    box-shadow: 0 0 10px rgba(209, 109, 0, 0.45);
