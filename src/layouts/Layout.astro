---
import '../styles/global.css';
import NoiseBackground from '../sugarize/NoiseBackground.astro';
import RubberBackground from '../sugarize/RubberBackground.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { ClientRouter } from 'astro:transitions';
import { withBasePath } from '../utils/withBasePath';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  disableNoise?: boolean;
  disableRubber?: boolean;
}

const {
  title,
  description = 'Cybersecurity Portfolio - Cryptography & Digital Forensics',
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  articleAuthor,
  disableNoise = false,
  disableRubber = false,
} = Astro.props;

const siteName = 'Nathan Kho Pancras';
const baseUrl = Astro.site ?? new URL(Astro.url.origin);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const toBasePath = (path: string) => {
  if (!path.startsWith('/')) return path;
  if (!basePath) return path;
  if (path === basePath || path.startsWith(`${basePath}/`)) return path;
  return withBasePath(path);
};
const pagePath = canonicalPath
  ? canonicalPath.startsWith('/')
    ? canonicalPath
    : `/${canonicalPath}`
  : Astro.url.pathname;
const canonicalUrl = new URL(toBasePath(pagePath), baseUrl);
const ogPathKey = pagePath === '/' ? 'index' : pagePath.replace(/^\/+|\/+$/g, '');
const ogImagePath = ogImage ?? withBasePath(`/open-graph/${ogPathKey}.png`);
const ogImageUrl = new URL(ogImagePath, baseUrl);
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ldItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Runs before first paint. ClientRouter replaces <html> attributes on every
      // navigation (and won't re-run this script), so re-apply after each swap.
      (() => {
        const applyTheme = () => {
          let stored = null;
          try { stored = localStorage.getItem('theme'); } catch {}
          const light = stored ? stored === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
          const root = document.documentElement;
          root.classList.toggle('light', light);
          root.classList.toggle('dark', !light);
          root.setAttribute('data-theme', light ? 'light' : 'dark');
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', applyTheme);
        window.addEventListener('theme-change', applyTheme);
      })();
    </script>
    <ClientRouter />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBasePath('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBasePath('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400..700&family=Inter:wght@400..700&display=swap" />
    {ldItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="min-h-screen transition-colors duration-300 relative overflow-x-hidden">
    {!disableNoise && <NoiseBackground />}
    {!disableRubber && <RubberBackground />}
    <slot />
    <Footer />
    <MusicPlayer />
  </body>
</html>

<script>
  import Lenis from "lenis";
  import "lenis/dist/lenis.css";

  // Lightweight entrance/scroll reveals (IntersectionObserver + Web Animations).
  const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const EASE_OUT = "cubic-bezier(0.33, 1, 0.68, 1)";
  const TRIGGER_RATIO = 0.82;

  const STAGGER_MS = 80;
  const MAX_STAGGER_STEPS = 6;

  let observer: IntersectionObserver | null = null;
  // Elements waiting to scroll into view, with their rise distance.
  const pending = new Map<Element, number>();

  if (localStorage.getItem("effects") === "off") {
    document.body.classList.add("no-effects");
  }

  const fadeIn = (el: Element, y: number, duration: number, delay = 0) => {
    (el as HTMLElement).style.opacity = "";
    el.animate(
      [
        { opacity: 0, transform: `translateY(${y}px)` },
        { opacity: 1, transform: "none" },
      ],
      { duration, delay, easing: EASE_OUT, fill: "backwards" },
    );
  };

  const byDocumentOrder = (a: Element, b: Element) =>
    a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;

  // Reveal a batch of elements that became visible together, staggered top-to-bottom.
  const revealBatch = (els: Element[]) => {
    els.sort(byDocumentOrder).forEach((el, i) => {
      fadeIn(el, pending.get(el) ?? 18, 850, Math.min(i, MAX_STAGGER_STEPS) * STAGGER_MS);
      pending.delete(el);
      observer?.unobserve(el);
    });
  };

  const teardown = () => {
    observer?.disconnect();
    observer = null;
    // Make sure nothing stays hidden if reveals are cancelled mid-page.
    pending.forEach((_, el) => ((el as HTMLElement).style.opacity = ""));
    pending.clear();
  };

  const buildAnimations = () => {
    teardown();
    if (localStorage.getItem("effects") === "off" || reduceMotionQuery.matches) return;

    observer = new IntersectionObserver(
      (entries) => revealBatch(entries.filter((e) => e.isIntersecting).map((e) => e.target)),
      { rootMargin: `0px 0px -${Math.round((1 - TRIGGER_RATIO) * 100)}% 0px` },
    );

    const heroTitle = document.querySelector(".hero-title");
    if (heroTitle) fadeIn(heroTitle, -14, 900);
    const heroSubtitle = document.querySelector(".hero-subtitle");
    if (heroSubtitle) fadeIn(heroSubtitle, -10, 900, 150);
    document.querySelectorAll(".hero-cta a").forEach((cta, i) => fadeIn(cta, 12, 800, 350 + i * 80));

    // Every card / block reveals individually as it enters the viewport.
    const targets: [Element, number][] = [
      ...Array.from(document.querySelectorAll(".reveal-up"), (el) => [el, 26] as [Element, number]),
      ...Array.from(document.querySelectorAll("[data-stagger-group] [data-stagger-item]"), (el) => [el, 18] as [Element, number]),
    ];
    const visibleNow: Element[] = [];
    for (const [el, y] of targets) {
      pending.set(el, y);
      if (el.getBoundingClientRect().top < window.innerHeight * TRIGGER_RATIO) {
        visibleNow.push(el);
      } else {
        (el as HTMLElement).style.opacity = "0";
        observer.observe(el);
      }
    }
    revealBatch(visibleNow);
  };

  // Smooth wheel scrolling. Lenis eases the real window scroll (no transformed
  // wrapper), so sticky elements, IntersectionObserver and Astro's scroll
  // restoration keep working. Touch scrolling stays native.
  let lenis: Lenis | null = null;

  const destroySmoothScroll = () => {
    lenis?.destroy();
    lenis = null;
  };

  const syncSmoothScroll = () => {
    const enabled = localStorage.getItem("effects") !== "off" && !reduceMotionQuery.matches;
    if (!enabled) {
      destroySmoothScroll();
    } else if (!lenis) {
      lenis = new Lenis({
        autoRaf: true,
        lerp: 0.1,
        // Let horizontally scrollable carousels / code blocks scroll natively.
        allowNestedScroll: true,
        // Don't scroll the page behind an open lightbox.
        prevent: (node) => !!node.closest?.("dialog"),
      });
    }
  };

  syncSmoothScroll();
  // Stop easing before the router swaps pages; the swap also wipes the classes
  // Lenis put on <html>. Start fresh on page-load, after the router has
  // scrolled the new page, so Lenis doesn't treat that jump as a scroll.
  document.addEventListener("astro:before-swap", destroySmoothScroll);
  document.addEventListener("astro:page-load", syncSmoothScroll);
  reduceMotionQuery.addEventListener("change", syncSmoothScroll);
  window.addEventListener("effects-toggle", syncSmoothScroll);

  // Initial astro:page-load waits for window "load" (images), so run immediately on
  // first load and only rebuild on page-load after a client-side navigation.
  let swapped = false;
  buildAnimations();
  document.addEventListener("astro:after-swap", () => (swapped = true));
  document.addEventListener("astro:page-load", () => {
    if (!swapped) return;
    swapped = false;
    buildAnimations();
  });
  document.addEventListener("astro:before-swap", teardown);
  reduceMotionQuery.addEventListener("change", buildAnimations);
  window.addEventListener("effects-toggle", buildAnimations);
  window.addEventListener("storage", (e) => {
    if (e.key === "effects") buildAnimations();
  });
</script>
