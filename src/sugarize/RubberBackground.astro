<canvas id="canvas" class="fixed inset-0 pointer-events-none opacity-65 mix-blend-soft-light z-30" transition:persist
  >Canvas not supported.</canvas
>

<style>
  body.no-effects #canvas {
    display: none !important;
  }

  canvas#canvas {
    display: block;
    background: transparent;
  }
</style>

<script>
  // Bundled module: runs once per session. The canvas is persisted across
  // client-side navigations, so a single render loop is kept alive (or stopped)
  // instead of a new one being stacked on every page swap.
  type Point = {
    x: number;
    y: number;
    xi: number;
    yi: number;
    vx: number;
    vy: number;
    phase: number;
    speed: number;
    amp: number;
  };

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const minDist = 52;
  const maxDist = 132;
  const maxPoints = 800;
  const ease = 0.3;
  const friction = 0.9;
  const radius = 1;

  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let rafId = 0;
  let X = window.innerWidth;
  let Y = window.innerHeight;
  let mouseX: number | null = null;
  let mouseY: number | null = null;
  let dist = 80;
  let lessThanSq = 2 * dist * dist;
  let mouseDist = 150;
  let lineWidth = 2;
  let cols = 0;
  let rows = 0;
  let color = "";
  let points: Point[] = [];

  const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));

  function updateCanvasSize() {
    if (!canvas || !ctx) return;
    X = window.innerWidth;
    Y = window.innerHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.style.width = X + "px";
    canvas.style.height = Y + "px";
    canvas.width = Math.floor(X * dpr);
    canvas.height = Math.floor(Y * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function updateGridMetrics() {
    const minSide = Math.min(X, Y);
    dist = clamp(Math.round(minSide / 11), minDist, maxDist);
    cols = Math.ceil(X / dist) + 1;
    rows = Math.ceil(Y / dist) + 1;

    // Increase spacing if the device would generate too many particles.
    while (cols * rows > maxPoints && dist < maxDist) {
      dist += 2;
      cols = Math.ceil(X / dist) + 1;
      rows = Math.ceil(Y / dist) + 1;
    }

    lineWidth = clamp(Math.round(dist / 30), 1, 3);
    lessThanSq = 2 * dist * dist;
    mouseDist = clamp(Math.round(dist * 1.6), 45, 130);
  }

  function buildPoints() {
    points = [];
    for (let i = 0; i < cols; i++) {
      for (let j = 0; j < rows; j++) {
        const x = i * dist;
        const y = j * dist;
        points.push({
          x,
          y,
          xi: x,
          yi: y,
          vx: 0,
          vy: 0,
          phase: Math.random() * Math.PI * 2,
          speed: 0.0007 + Math.random() * 0.0008,
          amp: dist * (0.04 + Math.random() * 0.05),
        });
      }
    }
  }

  function updateColor() {
    const light = document.documentElement.classList.contains("light");
    color = light ? "rgba(85,85,85,0.22)" : "rgba(170,198,245,0.28)";
  }

  function configureScene() {
    updateColor();
    updateCanvasSize();
    updateGridMetrics();
    buildPoints();
  }

  function springToward(p: Point, targetX: number, targetY: number) {
    p.vx = (p.vx + (targetX - p.x) * ease) * friction;
    p.vy = (p.vy + (targetY - p.y) * ease) * friction;
    p.x += p.vx;
    p.y += p.vy;
  }

  function updatePoint(p: Point, time: number) {
    const targetX = p.xi + Math.sin(time * p.speed + p.phase) * p.amp;
    const targetY = p.yi + Math.cos(time * p.speed * 1.12 + p.phase) * p.amp;

    if (mouseX === null || mouseY === null) {
      springToward(p, targetX, targetY);
      return;
    }

    const dx = mouseX - p.x;
    const dy = mouseY - p.y;
    const pointerDist = Math.sqrt(dx * dx + dy * dy);
    if (pointerDist < mouseDist) {
      const angle = Math.atan2(dy, dx);
      p.vx = -Math.cos(angle) * 5;
      p.vy = -Math.sin(angle) * 5;
      p.x += p.vx;
      p.y += p.vy;
    } else if (pointerDist < mouseDist + 10) {
      p.vx = 0;
      p.vy = 0;
    } else {
      springToward(p, targetX, targetY);
    }
  }

  function addLine(a: Point | undefined, b: Point | undefined) {
    if (!a || !b || !ctx) return;
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    if (dx * dx + dy * dy > lessThanSq) return;
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
  }

  function render(now: number) {
    if (!ctx) return;
    ctx.clearRect(0, 0, X, Y);

    // Connect only near grid neighbors, batched into a single stroke.
    ctx.beginPath();
    for (let i = 0; i < cols; i++) {
      for (let j = 0; j < rows; j++) {
        const current = points[i * rows + j];
        addLine(current, points[(i + 1) * rows + j]);
        if (j + 1 < rows) addLine(current, points[i * rows + (j + 1)]);
        if (j + 1 < rows) addLine(current, points[(i + 1) * rows + (j + 1)]);
        if (j > 0) addLine(current, points[(i + 1) * rows + (j - 1)]);
      }
    }
    ctx.lineWidth = lineWidth;
    ctx.strokeStyle = color;
    ctx.stroke();

    // All dots in a single fill.
    ctx.beginPath();
    for (const p of points) {
      updatePoint(p, now);
      ctx.moveTo(p.x + radius, p.y);
      ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
    }
    ctx.fillStyle = color;
    ctx.fill();

    rafId = requestAnimationFrame(render);
  }

  function stop() {
    cancelAnimationFrame(rafId);
    rafId = 0;
  }

  function sync() {
    const next = document.getElementById("canvas") as HTMLCanvasElement | null;
    const effectsOff = localStorage.getItem("effects") === "off";
    const enabled = !!next && !reduceMotion.matches && !effectsOff;
    if (!enabled) {
      stop();
      return;
    }
    if (next !== canvas) {
      stop();
      canvas = next;
      ctx = canvas.getContext("2d");
      configureScene();
    }
    if (!rafId) rafId = requestAnimationFrame(render);
  }

  let resizeQueued = false;
  window.addEventListener("resize", () => {
    if (resizeQueued || !canvas) return;
    resizeQueued = true;
    requestAnimationFrame(() => {
      configureScene();
      resizeQueued = false;
    });
  });

  window.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  const scheduleStart = () => {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(sync, { timeout: 500 });
    } else {
      setTimeout(sync, 200);
    }
  };

  if (document.readyState === "complete") {
    scheduleStart();
  } else {
    window.addEventListener("load", scheduleStart, { once: true });
  }

  document.addEventListener("astro:after-swap", sync);
  window.addEventListener("effects-toggle", sync);
  window.addEventListener("theme-change", updateColor);
  reduceMotion.addEventListener("change", sync);
</script>
